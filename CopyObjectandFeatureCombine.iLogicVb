' ============================================================
' USER CONFIGURATION & TOGGLES
' ============================================================
' V0.9.1 - Variable changes


Class JoinConfig
    ' --- Pop-Up Toggles (Code-Only) ---
    Public Shared ShowCompletionPopup As Boolean = False   ' True = shows "Done! Merged and deleted..." pop-up
    Public Shared ShowNoMatchPopup As Boolean = False      ' True = shows "No matching plates or nibs found." pop-up
End Class


' ============================================================
' MAIN ENTRY POINT
' ============================================================
Sub Main()
    Dim oApp As Inventor.Application = ThisApplication
    Dim oAsmDoc As AssemblyDocument = TryCast(oApp.ActiveDocument, AssemblyDocument)
    If oAsmDoc Is Nothing Then Exit Sub

    Dim oTO As TransientObjects = oApp.TransientObjects
    Dim oTBRep As TransientBRep = oApp.TransientBRep

    Dim oPlates As New List(Of ComponentOccurrence)
    Dim oNibs As New List(Of ComponentOccurrence)
    Dim oNibsToDelete As New HashSet(Of ComponentOccurrence)

    ' 1. Sort top-level occurrences into Plates and any <X>mm-STD-NIB parts
    For Each oOcc As ComponentOccurrence In oAsmDoc.ComponentDefinition.Occurrences
        If oOcc.Suppressed Then Continue For
        Dim fName As String = System.IO.Path.GetFileNameWithoutExtension(oOcc.Definition.Document.FullFileName)

        If System.Text.RegularExpressions.Regex.IsMatch(fName, "^\d+(\.\d+)?mm-STD-NIB$", System.Text.RegularExpressions.RegexOptions.IgnoreCase) Then
            oNibs.Add(oOcc)
        ElseIf System.Text.RegularExpressions.Regex.IsMatch(fName, "^\d{4,5}-[A-Za-z]{3}-[A-Za-z]{2}\d{2}-\d{2}$") Then
            oPlates.Add(oOcc)
        End If
    Next

    If oPlates.Count = 0 OrElse oNibs.Count = 0 Then
        If JoinConfig.ShowNoMatchPopup Then
            MessageBox.Show("No matching plates or nibs found.", "iLogic")
        End If
        Exit Sub
    End If

    ' Wrap entire operation in a single Undo Transaction and pause graphics/UI updates
    Dim oTrans As Transaction = oApp.TransactionManager.StartTransaction(oAsmDoc, "Merge & Delete Nibs")
    oApp.ScreenUpdating = False
    oApp.UserInterfaceManager.UserInteractionDisabled = True

    Try
        ' Cache native nib solid body per nib file path (supports mixed thicknesses in one assembly)
        Dim oNativeNibBodies As New Dictionary(Of String, SurfaceBody)(StringComparer.OrdinalIgnoreCase)
        For Each oNibOcc As ComponentOccurrence In oNibs
            Dim nibPath As String = oNibOcc.Definition.Document.FullFileName
            If Not oNativeNibBodies.ContainsKey(nibPath) Then
                oNativeNibBodies(nibPath) = oNibOcc.Definition.SurfaceBodies.Item(1)
            End If
        Next

        ' Track remaining nibs so already-matched nibs aren't checked against subsequent plates
        Dim oRemainingNibs As New List(Of ComponentOccurrence)(oNibs)

        ' 2. Process each plate
        For Each oPlate As ComponentOccurrence In oPlates
            Dim oPlateBox As Box = oPlate.RangeBox
            Dim oCandidateNibs As New List(Of ComponentOccurrence)

            ' Fast A: Axis-Aligned Bounding Box (MinPoint / MaxPoint) filter in memory
            For Each oNib As ComponentOccurrence In oRemainingNibs
                Dim oNibBox As Box = oNib.RangeBox
                Dim boxesOverlap As Boolean =
                    (oPlateBox.MinPoint.X <= oNibBox.MaxPoint.X AndAlso oPlateBox.MaxPoint.X >= oNibBox.MinPoint.X) AndAlso
                    (oPlateBox.MinPoint.Y <= oNibBox.MaxPoint.Y AndAlso oPlateBox.MaxPoint.Y >= oNibBox.MinPoint.Y) AndAlso
                    (oPlateBox.MinPoint.Z <= oNibBox.MaxPoint.Z AndAlso oPlateBox.MaxPoint.Z >= oNibBox.MinPoint.Z)

                If boxesOverlap Then
                    oCandidateNibs.Add(oNib)
                End If
            Next

            If oCandidateNibs.Count = 0 Then Continue For

            Dim oPlateDef As PartComponentDefinition = oPlate.Definition
            Dim oPlateDoc As PartDocument = oPlateDef.Document
            Dim oBaseBody As SurfaceBody = oPlateDef.SurfaceBodies.Item(1)

            Dim oToolBodies As ObjectCollection = oTO.CreateObjectCollection()
            Dim oSculptCol As ObjectCollection = oTO.CreateObjectCollection()
            Dim oSculptFeats As SculptFeatures = oPlateDef.Features.SculptFeatures
            Dim plateModified As Boolean = False

            ' Invert plate matrix once per plate
            Dim oPlateInvMatrix As Matrix = oPlate.Transformation
            oPlateInvMatrix.Invert()

            ' Fast B: Run exact interference check ONLY on bounding-box candidates
            For Each oNib As ComponentOccurrence In oCandidateNibs
                Dim oCheckSet1 As ObjectCollection = oTO.CreateObjectCollection()
                Dim oCheckSet2 As ObjectCollection = oTO.CreateObjectCollection()
                oCheckSet1.Add(oPlate)
                oCheckSet2.Add(oNib)

                Dim oResults As InterferenceResults = oAsmDoc.ComponentDefinition.AnalyzeInterference(oCheckSet1, oCheckSet2)

                If oResults.Count > 0 Then
                    Dim nibPath As String = oNib.Definition.Document.FullFileName
                    Dim oCopiedBody As SurfaceBody = oTBRep.Copy(oNativeNibBodies(nibPath))
                    oTBRep.Transform(oCopiedBody, oNib.Transformation)
                    oTBRep.Transform(oCopiedBody, oPlateInvMatrix)

                    Dim surfCountBefore As Integer = oPlateDef.WorkSurfaces.Count

                    Dim oBaseFeats As NonParametricBaseFeatures = oPlateDef.Features.NonParametricBaseFeatures
                    Dim oDef As NonParametricBaseFeatureDefinition = oBaseFeats.CreateDefinition()
                    Dim oInputCol As ObjectCollection = oTO.CreateObjectCollection()
                    oInputCol.Add(oCopiedBody)

                    oDef.BRepEntities = oInputCol
                    oDef.OutputType = BaseFeatureOutputTypeEnum.kSolidOutputType
                    oDef.IsAssociative = False
                    oDef.DeleteOriginal = True

                    Dim oNewFeat As NonParametricBaseFeature = oBaseFeats.AddByDefinition(oDef)
                    plateModified = True

                    If oNewFeat.SurfaceBodies.Count > 0 AndAlso oNewFeat.SurfaceBodies.Item(1).IsSolid Then
                        oToolBodies.Add(oNewFeat.SurfaceBodies.Item(1))
                    ElseIf oPlateDef.WorkSurfaces.Count > surfCountBefore Then
                        Dim oNewestWorkSurf As WorkSurface = oPlateDef.WorkSurfaces.Item(oPlateDef.WorkSurfaces.Count)
                        Dim oSculptSurf As SculptSurface = oSculptFeats.CreateSculptSurface(oNewestWorkSurf, PartFeatureExtentDirectionEnum.kNegativeExtentDirection)
                        oSculptCol.Add(oSculptSurf)
                    End If

                    oNibsToDelete.Add(oNib)
                End If
            Next

            ' Remove matched nibs from pool so later plates skip them completely
            For Each oMatchedNib As ComponentOccurrence In oNibsToDelete
                oRemainingNibs.Remove(oMatchedNib)
            Next

            ' 3. Batch-join all solids and surfaces for this plate in single features
            If oToolBodies.Count > 0 Then
                oPlateDef.Features.CombineFeatures.Add(oBaseBody, oToolBodies, PartFeatureOperationEnum.kJoinOperation, False)
            End If

            If oSculptCol.Count > 0 Then
                oSculptFeats.Add(oSculptCol, PartFeatureOperationEnum.kJoinOperation, oBaseBody)
            End If

            ' 4. Single rebuild per plate instead of per nib
            If plateModified Then
                oPlateDoc.Update2(True)
            End If
        Next

        ' 5. Delete all matched nibs from the assembly
        Dim deletedCount As Integer = oNibsToDelete.Count
        For Each oNibToDelete As ComponentOccurrence In oNibsToDelete
            oNibToDelete.Delete()
        Next

        oAsmDoc.Update2(True)
        oTrans.End()

        oApp.UserInterfaceManager.UserInteractionDisabled = False
        oApp.ScreenUpdating = True

        If JoinConfig.ShowCompletionPopup Then
            MessageBox.Show("Done! Merged and deleted " & deletedCount & " nib(s).", "iLogic")
        End If

    Catch ex As Exception
        oTrans.Abort()
        oApp.UserInterfaceManager.UserInteractionDisabled = False
        oApp.ScreenUpdating = True
        MessageBox.Show("Error: " & ex.Message, "iLogic")
    End Try
End Sub
