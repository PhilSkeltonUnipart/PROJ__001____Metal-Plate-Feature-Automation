Sub Main()
    Dim oAsmDoc As AssemblyDocument = ThisApplication.ActiveDocument
    Dim oTO As TransientObjects = ThisApplication.TransientObjects
    Dim oTBRep As TransientBRep = ThisApplication.TransientBRep

    Dim oPlates As New List(Of ComponentOccurrence)
    Dim oNibs As New List(Of ComponentOccurrence)

    ' 1. Sort top-level occurrences into Plates and Nibs
    For Each oOcc As ComponentOccurrence In oAsmDoc.ComponentDefinition.Occurrences
        If oOcc.Suppressed Then Continue For
        Dim fName As String = System.IO.Path.GetFileNameWithoutExtension(oOcc.Definition.Document.FullFileName)

        If fName = "3mm-STD-NIB" Then
            oNibs.Add(oOcc)
        ElseIf System.Text.RegularExpressions.Regex.IsMatch(fName, "^\d{5}-[A-Za-z]{3}-[A-Za-z]{2}\d{2}-\d{2}$") Then
            oPlates.Add(oOcc)
        End If
    Next

    ' 2. Check each plate against each nib
    For Each oPlate As ComponentOccurrence In oPlates
        Dim oPlateDef As PartComponentDefinition = oPlate.Definition
        Dim oBaseBody As SurfaceBody = oPlateDef.SurfaceBodies.Item(1)
        Dim oToolBodies As ObjectCollection = oTO.CreateObjectCollection()

        ' Get inverse matrix of the plate
        Dim oPlateInvMatrix As Matrix = oPlate.Transformation
        oPlateInvMatrix.Invert()

        For Each oNib As ComponentOccurrence In oNibs
            Dim oCheckSet1 As ObjectCollection = oTO.CreateObjectCollection()
            Dim oCheckSet2 As ObjectCollection = oTO.CreateObjectCollection()
            oCheckSet1.Add(oPlate)
            oCheckSet2.Add(oNib)

            Dim oResults As InterferenceResults = oAsmDoc.ComponentDefinition.AnalyzeInterference(oCheckSet1, oCheckSet2)

            If oResults.Count > 0 Then
                ' Grab the native solid body from the Nib's PartDefinition
                Dim oNativeNibBody As SurfaceBody = oNib.Definition.SurfaceBodies.Item(1)
                Dim oCopiedBody As SurfaceBody = oTBRep.Copy(oNativeNibBody)

                ' Calculate exact relative transform: Plate^-1 * Nib
                Dim oRelativeMatrix As Matrix = oPlateInvMatrix.Copy()
                oRelativeMatrix.TransformBy(oNib.Transformation)
                oTBRep.Transform(oCopiedBody, oRelativeMatrix)

                ' Insert as a Solid Base Feature
                Dim oBaseFeats As NonParametricBaseFeatures = oPlateDef.Features.NonParametricBaseFeatures
                Dim oDef As NonParametricBaseFeatureDefinition = oBaseFeats.CreateDefinition()
                Dim oInputCol As ObjectCollection = oTO.CreateObjectCollection()
                oInputCol.Add(oCopiedBody)

                oDef.BRepEntities = oInputCol
                oDef.OutputType = BaseFeatureOutputTypeEnum.kSolidOutputType
                oDef.IsAssociative = False

                Dim oNewFeat As NonParametricBaseFeature = oBaseFeats.AddByDefinition(oDef)
                
                ' Verify it created a solid before adding to Combine
                If oNewFeat.SurfaceBodies.Item(1).IsSolid Then
                    oToolBodies.Add(oNewFeat.SurfaceBodies.Item(1))
                End If
            End If
        Next

        ' 3. Combine-Join all matched nibs into the plate
        If oToolBodies.Count > 0 Then
            oPlateDef.Features.CombineFeatures.Add(oBaseBody, oToolBodies, PartFeatureOperationEnum.kJoinOperation, False)
        End If
    Next

    oAsmDoc.Update()
    MessageBox.Show("Done!", "iLogic")
End Sub

