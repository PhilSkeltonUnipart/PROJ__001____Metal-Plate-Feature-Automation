' ============================================================
' INVENTOR NIB AUTOMATION
' Assembly / Plate Scanner
'
' iLogic Rule
' ============================================================


' ============================================================
' MAIN
' ============================================================

Sub Main()

    ' --------------------------------------------------------
    ' SETTINGS
    ' --------------------------------------------------------

    Dim PlateComponentType As String = "PL"

    Dim DebugLogging As Boolean = True


    ' --------------------------------------------------------
    ' START LOGGER
    ' --------------------------------------------------------

    Logger.Start()


    Logger.Section("STARTING ASSEMBLY SCAN")


    Try

        Logger.Info( _
            "Inventor version: " & _
            ThisApplication.SoftwareVersion.ToString())


        ' ----------------------------------------------------
        ' GET ACTIVE DOCUMENT
        ' ----------------------------------------------------

        Dim ActiveDoc As Inventor.Document =
            ThisApplication.ActiveDocument


        If ActiveDoc Is Nothing Then

            Logger.Error("No active document found.")

            ShowLog()

            Exit Sub

        End If


        Logger.Info( _
            "Active document: " & _
            ActiveDoc.DisplayName)


        ' ----------------------------------------------------
        ' CHECK DOCUMENT TYPE
        ' ----------------------------------------------------

        If ActiveDoc.DocumentType <> _
            Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then

            Logger.Error( _
                "Active document is not an assembly.")

            Logger.Info( _
                "Please open an assembly before running the scanner.")

            ShowLog()

            Exit Sub

        End If


        ' ----------------------------------------------------
        ' CONVERT TO ASSEMBLY DOCUMENT
        ' ----------------------------------------------------

        Dim AssemblyDoc As Inventor.AssemblyDocument =
            CType(ActiveDoc, Inventor.AssemblyDocument)


        ' ----------------------------------------------------
        ' ASSEMBLY INFORMATION
        ' ----------------------------------------------------

        Logger.Section("ASSEMBLY INFORMATION")


        Dim AssemblyName As String =
            System.IO.Path.GetFileNameWithoutExtension( _
                AssemblyDoc.FullFileName)


        Logger.Info( _
            "Assembly filename: " & AssemblyName)


        Dim AssemblyData As AssemblyNameData =
            ParseAssemblyName(AssemblyName)


        If AssemblyData.IsValid Then

            Logger.Success( _
                "Assembly naming convention: PASS")

            Logger.Info( _
                "Project: " & _
                AssemblyData.ProjectNumber)

            Logger.Info( _
                "Description: " & _
                AssemblyData.Description)

            Logger.Info( _
                "Assembly type: " & _
                AssemblyData.AssemblyType)

            Logger.Info( _
                "Assembly number: " & _
                AssemblyData.AssemblyNumber)

            Logger.Info( _
                "Revision: " & _
                AssemblyData.Revision)

        Else

            Logger.Warning( _
                "Assembly naming convention: FAIL")

        End If


        ' ----------------------------------------------------
        ' COUNTERS
        ' ----------------------------------------------------

        Dim TotalOccurrences As Integer = 0
        Dim TotalParts As Integer = 0
        Dim SheetMetalParts As Integer = 0
        Dim PLComponents As Integer = 0
        Dim EligiblePlates As Integer = 0
        Dim InvalidNames As Integer = 0
        Dim SubAssemblies As Integer = 0


        ' ----------------------------------------------------
        ' SCAN ASSEMBLY
        ' ----------------------------------------------------

        Logger.Section("SCANNING COMPONENTS")


        ScanOccurrences( _
            AssemblyDoc.ComponentDefinition.Occurrences, _
            PlateComponentType, _
            DebugLogging, _
            TotalOccurrences, _
            TotalParts, _
            SheetMetalParts, _
            PLComponents, _
            EligiblePlates, _
            InvalidNames, _
            SubAssemblies)


        ' ----------------------------------------------------
        ' SUMMARY
        ' ----------------------------------------------------

        Logger.Section("SCAN SUMMARY")


        Logger.Info( _
            "Assemblies found: " & _
            SubAssemblies)

        Logger.Info( _
            "Total occurrences: " & _
            TotalOccurrences)

        Logger.Info( _
            "Total parts: " & _
            TotalParts)

        Logger.Info( _
            "Sheet metal parts: " & _
            SheetMetalParts)

        Logger.Info( _
            "PL components: " & _
            PLComponents)

        Logger.Info( _
            "Eligible plates: " & _
            EligiblePlates)

        Logger.Info( _
            "Invalid filenames: " & _
            InvalidNames)


        Logger.Section("SCAN COMPLETE")


        Logger.Success( _
            "Assembly scan completed.")


    Catch ex As Exception

        Logger.Error( _
            "UNEXPECTED ERROR")

        Logger.Error( _
            ex.Message)

        Logger.Debug( _
            ex.StackTrace)

    End Try


    ' --------------------------------------------------------
    ' SHOW LOG
    ' --------------------------------------------------------

    ShowLog()


End Sub


' ============================================================
' RECURSIVE ASSEMBLY SCANNER
' ============================================================

Sub ScanOccurrences( _
    Occurrences As Inventor.ComponentOccurrences, _
    PlateComponentType As String, _
    DebugLogging As Boolean, _
    ByRef TotalOccurrences As Integer, _
    ByRef TotalParts As Integer, _
    ByRef SheetMetalParts As Integer, _
    ByRef PLComponents As Integer, _
    ByRef EligiblePlates As Integer, _
    ByRef InvalidNames As Integer, _
    ByRef SubAssemblies As Integer)


    For Each Occurrence As Inventor.ComponentOccurrence _
        In Occurrences


        TotalOccurrences += 1


        Logger.Debug( _
            "Inspecting occurrence: " & _
            Occurrence.Name)


        ' ====================================================
        ' SUPPRESSED COMPONENT
        ' ====================================================

        If Occurrence.Suppressed Then

            Logger.Warning( _
                Occurrence.Name & _
                " is suppressed - skipped.")

            Continue For

        End If


        ' ====================================================
        ' ASSEMBLY
        ' ====================================================

        If Occurrence.DefinitionDocumentType = _
            Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then


            SubAssemblies += 1


            Dim SubAssemblyDoc As Inventor.AssemblyDocument =
                CType(Occurrence.Definition.Document, _
                      Inventor.AssemblyDocument)


            Dim SubAssemblyName As String =
                System.IO.Path.GetFileNameWithoutExtension( _
                    SubAssemblyDoc.FullFileName)


            Logger.Section("SUBASSEMBLY")


            Logger.Info( _
                "Name: " & SubAssemblyName)


            Dim SubAssemblyData As AssemblyNameData =
                ParseAssemblyName(SubAssemblyName)


            If SubAssemblyData.IsValid Then

                Logger.Success( _
                    "Naming convention: PASS")


                Logger.Debug( _
                    "Project: " & _
                    SubAssemblyData.ProjectNumber)


                Logger.Debug( _
                    "Description: " & _
                    SubAssemblyData.Description)


                Logger.Debug( _
                    "Type: " & _
                    SubAssemblyData.AssemblyType)


                Logger.Debug( _
                    "Number: " & _
                    SubAssemblyData.AssemblyNumber)


                Logger.Debug( _
                    "Revision: " & _
                    SubAssemblyData.Revision)


            Else

                Logger.Warning( _
                    "Subassembly naming convention: FAIL")

            End If


            ' ------------------------------------------------
            ' RECURSE INTO SUBASSEMBLY
            ' ------------------------------------------------

            ScanOccurrences( _
                SubAssemblyDoc.ComponentDefinition.Occurrences, _
                PlateComponentType, _
                DebugLogging, _
                TotalOccurrences, _
                TotalParts, _
                SheetMetalParts, _
                PLComponents, _
                EligiblePlates, _
                InvalidNames, _
                SubAssemblies)


            Continue For


        End If


        ' ====================================================
        ' PART
        ' ====================================================

        TotalParts += 1


        Dim PartDoc As Inventor.PartDocument =
            CType(Occurrence.Definition.Document, _
                  Inventor.PartDocument)


        Dim PartName As String =
            System.IO.Path.GetFileNameWithoutExtension( _
                PartDoc.FullFileName)


        Logger.Section("PART")


        Logger.Info( _
            "Occurrence: " & _
            Occurrence.Name)


        Logger.Info( _
            "Filename: " & _
            PartName)


        ' ====================================================
        ' PARSE PART NAME
        ' ====================================================

        Dim PartData As PartNameData =
            ParsePartName(PartName)


        If Not PartData.IsValid Then

            InvalidNames += 1


            Logger.Warning( _
                "Part naming convention: FAIL")


            Logger.Warning( _
                "Unable to determine component type.")


            Continue For

        End If


        Logger.Success( _
            "Part naming convention: PASS")


        Logger.Debug( _
            "Project: " & _
            PartData.ProjectNumber)


        Logger.Debug( _
            "Project ID: " & _
            PartData.ProjectIdentifier)


        Logger.Debug( _
            "Component type: " & _
            PartData.ComponentType)


        Logger.Debug( _
            "Component number: " & _
            PartData.ComponentNumber)


        Logger.Debug( _
            "Revision: " & _
            PartData.Revision)


        ' ====================================================
        ' CHECK COMPONENT TYPE
        ' ====================================================

        If PartData.ComponentType <> _
            PlateComponentType Then


            Logger.Info( _
                "Component type is not " & _
                PlateComponentType & _
                " - ignored.")


            Continue For

        End If


        PLComponents += 1


        Logger.Info( _
            "Component identified as PL plate.")


        ' ====================================================
        ' CHECK SHEET METAL
        ' ====================================================

        Dim IsSheetMetal As Boolean =
            IsSheetMetalPart(PartDoc)


        If IsSheetMetal Then

            SheetMetalParts += 1


            Logger.Success( _
                "Sheet metal check: PASS")


        Else

            Logger.Warning( _
                "Sheet metal check: FAIL")


            Logger.Warning( _
                "PL component is not recognised as sheet metal.")


            Continue For

        End If


        ' ====================================================
        ' SHEET METAL INFORMATION
        ' ====================================================

        Try


            Dim SheetMetalDef As _
                Inventor.SheetMetalComponentDefinition =

                CType( _
                    PartDoc.ComponentDefinition, _
                    Inventor.SheetMetalComponentDefinition)


            Dim ThicknessMM As Double = _
                SheetMetalDef.Thickness.Value * 10


            Logger.Info( _
                "Thickness: " & _
                Math.Round(ThicknessMM, 3) & _
                " mm")


        Catch ex As Exception


            Logger.Warning( _
                "Could not read sheet metal thickness.")


            Logger.Debug( _
                ex.Message)


        End Try


        ' ====================================================
        ' PLATE IS CURRENTLY ELIGIBLE
        ' ====================================================

        EligiblePlates += 1


        Logger.Success( _
            "PLATE ELIGIBILITY: PASS")


        ' ====================================================
        ' FUTURE GEOMETRY PROCESSING
        ' ====================================================
        '
        ' DetectPlateEdges()
        '
        ' DetectCorners()
        '
        ' FindCandidateNibLocations()
        '
        ' SelectNib()
        '
        ' InsertNib()
        '
        ' ====================================================


    Next


End Sub


' ============================================================
' SHEET METAL CHECK
' ============================================================

Function IsSheetMetalPart( _
    PartDoc As Inventor.PartDocument) As Boolean


    Try


        Dim Definition As Inventor.ComponentDefinition =
            PartDoc.ComponentDefinition


        If TypeOf Definition Is _
            Inventor.SheetMetalComponentDefinition Then


            Return True


        End If


    Catch ex As Exception


        Logger.Debug( _
            "Sheet metal check failed: " & _
            ex.Message)


    End Try


    Return False


End Function


' ============================================================
' PART NAME DATA
' ============================================================

Class PartNameData

    Public IsValid As Boolean = False

    Public ProjectNumber As String

    Public ProjectIdentifier As String

    Public ComponentType As String

    Public ComponentNumber As String

    Public Revision As String

End Class


' ============================================================
' PARSE PART NAME
'
' XXXX-CCC-VVBB-NN
'
' Example:
'
' 9187-DCS-PL07-03
'
' ============================================================

Function ParsePartName( _
    Name As String) As PartNameData


    Dim Result As New PartNameData


    Dim Pattern As String = _
        "^([0-9]{4})-([A-Za-z]{3})-([A-Za-z]{2})([0-9]{2})-([0-9]{2})$"


    Dim Match As System.Text.RegularExpressions.Match = _
        System.Text.RegularExpressions.Regex.Match( _
            Name, Pattern)


    If Not Match.Success Then

        Return Result

    End If


    Result.IsValid = True


    Result.ProjectNumber = _
        Match.Groups(1).Value


    Result.ProjectIdentifier = _
        Match.Groups(2).Value


    Result.ComponentType = _
        Match.Groups(3).Value.ToUpper()


    Result.ComponentNumber = _
        Match.Groups(4).Value


    Result.Revision = _
        Match.Groups(5).Value


    Return Result


End Function


' ============================================================
' ASSEMBLY NAME DATA
' ============================================================

Class AssemblyNameData

    Public IsValid As Boolean = False

    Public ProjectNumber As String

    Public Description As String

    Public AssemblyType As String

    Public AssemblyNumber As String

    Public Revision As String

End Class


' ============================================================
' PARSE ASSEMBLY NAME
'
' XXXX-DESCRIPTION-TTNN-VV
'
' Examples:
'
' 9187-DitchCrossingSlab-GA01-01
'
' 9187-InternalStructure-SA01-01
'
' ============================================================

Function ParseAssemblyName( _
    Name As String) As AssemblyNameData


    Dim Result As New AssemblyNameData


    Dim Pattern As String = _
        "^([0-9]{4})-(.+)-([A-Za-z]{2})([0-9]{2})-([0-9]{2})$"


    Dim Match As System.Text.RegularExpressions.Match = _
        System.Text.RegularExpressions.Regex.Match( _
            Name, Pattern)


    If Not Match.Success Then

        Return Result

    End If


    Result.IsValid = True


    Result.ProjectNumber = _
        Match.Groups(1).Value


    Result.Description = _
        Match.Groups(2).Value


    Result.AssemblyType = _
        Match.Groups(3).Value.ToUpper()


    Result.AssemblyNumber = _
        Match.Groups(4).Value


    Result.Revision = _
        Match.Groups(5).Value


    Return Result


End Function


' ============================================================
' SHOW LOG
' ============================================================

Sub ShowLog()


    Dim LogText As String = _
        Logger.GetText()


    MsgBox( _
        LogText, _
        MsgBoxStyle.Information, _
        "Inventor Nib Automation Log")


End Sub


' ============================================================
' LOGGER
'
' This class is deliberately AFTER Sub Main().
'
' This is the structure iLogic expects when adding
' additional classes to a rule.
' ============================================================

Class Logger


    Private Shared LogLines As _
        New System.Collections.Generic.List(Of String)


    ' --------------------------------------------------------
    ' START
    ' --------------------------------------------------------

    Public Shared Sub Start()


        LogLines.Clear()


        Add( _
            "============================================================")


        Add( _
            "INVENTOR NIB AUTOMATION LOG")


        Add( _
            "Started: " & _
            DateTime.Now.ToString( _
                "yyyy-MM-dd HH:mm:ss"))


        Add( _
            "============================================================")


    End Sub


    ' --------------------------------------------------------
    ' INFO
    ' --------------------------------------------------------

    Public Shared Sub Info( _
        Message As String)


        Add( _
            "[INFO]    " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' SUCCESS
    ' --------------------------------------------------------

    Public Shared Sub Success( _
        Message As String)


        Add( _
            "[SUCCESS] " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' WARNING
    ' --------------------------------------------------------

    Public Shared Sub Warning( _
        Message As String)


        Add( _
            "[WARNING] " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' ERROR
    ' --------------------------------------------------------

    Public Shared Sub [Error]( _
        Message As String)


        Add( _
            "[ERROR]   " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' DEBUG
    ' --------------------------------------------------------

    Public Shared Sub Debug( _
        Message As String)


        Add( _
            "[DEBUG]   " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' SECTION
    ' --------------------------------------------------------

    Public Shared Sub Section( _
        Name As String)


        Add("")


        Add( _
            "------------------------------------------------------------")


        Add(Name)


        Add( _
            "------------------------------------------------------------")


    End Sub


    ' --------------------------------------------------------
    ' INTERNAL ADD
    ' --------------------------------------------------------

    Private Shared Sub Add( _
        Message As String)


        Dim TimeStamp As String = _
            DateTime.Now.ToString("HH:mm:ss")


        LogLines.Add( _
            "[" & _
            TimeStamp & _
            "] " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' GET LOG
    ' --------------------------------------------------------

    Public Shared Function GetText() As String


        Return String.Join( _
            vbCrLf, _
            LogLines)


    End Function


    ' --------------------------------------------------------
    ' SAVE LOG
    ' --------------------------------------------------------

    Public Shared Sub SaveToFile( _
        FilePath As String)


        Try


            System.IO.File.WriteAllText( _
                FilePath, _
                GetText())


        Catch ex As Exception


            MsgBox( _
                "Unable to save log file:" & _
                vbCrLf & _
                ex.Message)


        End Try


    End Sub


End Class
