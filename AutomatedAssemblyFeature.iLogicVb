Option Explicit On
' ============================================================
' INVENTOR NIB AUTOMATION (v0.8.0 - Multi-Thickness <X>mm-STD-NIB)
'
' Automatically matches each plate's measured physical thickness
' to <X>mm-STD-NIB.ipt in the local or central server folder.
' ============================================================


' ============================================================
' USER CONFIGURATION & TOGGLES (EDIT RULES HERE)
' ============================================================
Class NibConfig
    ' --- Diagnostic Toggles (Code-Only, No Pop-Ups) ---
    Public Shared EnableDiagnosticLog As Boolean = False   ' True = writes .log file next to assembly
    Public Shared ShowCandidateMarkers As Boolean = False  ' True = draws 3D crosses in assembly view

    ' --- Component & Reference Rules ---
    Public Shared PlateComponentType As String = "PL"
    Public Shared NibFileSuffix As String = "mm-STD-NIB.ipt"
    Public Shared CentralNibFolder As String = "V:\05 Engineering\05-02 CAD\AutoDesk\UCT - Content Centre\01 - USER COMMAND AUTOMATION GEOMETRY"
    Public Shared MaxStagingOccurrences As Integer = 300

    ' --- Nibbing Edge & Spacing Rules (mm) ---
    Public Shared MinimumNibEdgeLengthMM As Double = 150.0
    Public Shared ExternalEndClearanceMM As Double = 75.0
    Public Shared InternalEndClearanceMM As Double = 50.0
    Public Shared MaximumNibSpacingMM As Double = 300.0
    Public Shared ExternalMinimumUsableLengthMM As Double = 150.0
    Public Shared InternalMinimumUsableLengthMM As Double = 150.0
    Public Shared MinimumNibCentreSeparationMM As Double = 150.0
    Public Shared LongEdgeThresholdRatio As Double = 0.75  ' Used by "Internal openings - long edges only"

    ' --- Geometry & Join Tolerances ---
    Public Shared NibJoinOverlapMM As Double = 0.2
    Public Shared NibThicknessMatchToleranceMM As Double = 0.25
    Public Shared ThicknessWarningToleranceMM As Double = 0.1
    Public Shared OrientationToleranceDegrees As Double = 1.0
End Class


' ============================================================
' MAIN ENTRY POINT
' ============================================================
Sub Main()
    Logger.Start()
    Logger.Section("STARTING ASSEMBLY SCAN (MULTI-THICKNESS)")

    Dim AssemblyDoc As Inventor.AssemblyDocument = Nothing

    Try
        Dim ActiveDoc As Inventor.Document = ThisApplication.ActiveDocument
        If ActiveDoc Is Nothing OrElse ActiveDoc.DocumentType <> Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then
            Logger.Error("Active document is missing or is not an assembly.")
            SaveLogIfEnabled(Nothing)
            Exit Sub
        End If

        AssemblyDoc = CType(ActiveDoc, Inventor.AssemblyDocument)
        Logger.Info("Assembly: " & AssemblyDoc.DisplayName)

        ' 1. ONLY POP-UP: Select Nibbing Profile
        Dim NibProfiles As String() = { _
            "Internal openings - all suitable edges", _
            "Internal openings - long edges only", _
            "Internal openings + external perimeter", _
            "External perimeter only"}

        Dim NibProfile As String = InputListBox( _
            "Choose the nibbing profile for this run.", _
            NibProfiles, NibProfiles(0), _
            "Inventor Nib Automation - Profile", "Nibbing profiles")
        If String.IsNullOrWhiteSpace(NibProfile) Then Exit Sub

        ' 2. Scan Assembly, Resolve <X>mm-STD-NIB.ipt Per Plate & Analyse Boundaries
        Dim Stats As New ScanStats()
        Dim InternalMarkers As New System.Collections.Generic.List(Of Double)
        Dim ExternalMarkers As New System.Collections.Generic.List(Of Double)
        Dim Placements As New System.Collections.Generic.List(Of NibPlacement)
        Dim NibCache As New System.Collections.Generic.Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)
        Dim RootTransform As Inventor.Matrix = ThisApplication.TransientGeometry.CreateMatrix()

        ScanOccurrences( _
            AssemblyDoc, AssemblyDoc.ComponentDefinition.Occurrences, NibProfile, RootTransform, _
            NibCache, InternalMarkers, ExternalMarkers, Placements, Stats)

        ' 3. Draw or Clear Temporary 3D Candidate Markers
        UpdateCandidateMarkers(AssemblyDoc, InternalMarkers, ExternalMarkers)

        ' 4. Stage Nib Occurrences & Join Solids into Plates
        If Placements.Count > 0 Then
            Dim StagingOccurrences As New System.Collections.Generic.List(Of Inventor.ComponentOccurrence)
            If CreateNibStagingOccurrences(AssemblyDoc, Placements, StagingOccurrences) Then
                GenerateNibGeometryInPlateParts(Placements, StagingOccurrences)
            End If
        Else
            Logger.Warning("No nib geometry generated (no valid placements or matching <X>mm-STD-NIB.ipt files).")
        End If

        Logger.Section("SCAN SUMMARY")
        Logger.Info("Subassemblies: " & Stats.SubAssemblies & " | Total Parts: " & Stats.TotalParts & _
                    " | PL Sheet Metal: " & Stats.EligiblePlates & " | Invalid Names: " & Stats.InvalidNames)
        Logger.Success("Run completed.")

    Catch ex As Exception
        Logger.Error("UNEXPECTED ERROR: " & ex.Message)
        Logger.Debug(ex.StackTrace)
    End Try

    SaveLogIfEnabled(AssemblyDoc)
End Sub


' ============================================================
' DATA MODELS
' ============================================================
Class ScanStats
    Public TotalOccurrences As Integer = 0
    Public TotalParts As Integer = 0
    Public SheetMetalParts As Integer = 0
    Public PLComponents As Integer = 0
    Public EligiblePlates As Integer = 0
    Public InvalidNames As Integer = 0
    Public SubAssemblies As Integer = 0
End Class

Class NibPlacement
    Public PlatePath As String
    Public NibFilePath As String
    ' Plate-local frame
    Public PartOrigin As Inventor.Point
    Public PartX As Inventor.Vector
    Public PartY As Inventor.Vector
    Public PartZ As Inventor.Vector
    ' Assembly-space frame
    Public AsmOrigin As Inventor.Point
    Public AsmX As Inventor.Vector
    Public AsmY As Inventor.Vector
    Public AsmZ As Inventor.Vector
    Public StagingIndex As Integer
End Class


' ============================================================
' RECURSIVE ASSEMBLY SCANNER
' ============================================================
Sub ScanOccurrences( _
    RootAssemblyDoc As Inventor.AssemblyDocument, _
    Occurrences As Inventor.ComponentOccurrences, _
    NibProfile As String, _
    ParentTransform As Inventor.Matrix, _
    NibCache As System.Collections.Generic.Dictionary(Of String, String), _
    InternalMarkers As System.Collections.Generic.List(Of Double), _
    ExternalMarkers As System.Collections.Generic.List(Of Double), _
    Placements As System.Collections.Generic.List(Of NibPlacement), _
    Stats As ScanStats)

    For Each Occ As Inventor.ComponentOccurrence In Occurrences
        Stats.TotalOccurrences += 1
        If Occ.Suppressed Then Continue For

        Dim CurrentTransform As Inventor.Matrix = ParentTransform.Copy()
        CurrentTransform.PostMultiplyBy(Occ.Transformation)

        ' Subassembly recursion
        If Occ.DefinitionDocumentType = Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then
            Stats.SubAssemblies += 1
            Dim SubDoc As Inventor.AssemblyDocument = CType(Occ.Definition.Document, Inventor.AssemblyDocument)
            ScanOccurrences(RootAssemblyDoc, SubDoc.ComponentDefinition.Occurrences, NibProfile, CurrentTransform, _
                            NibCache, InternalMarkers, ExternalMarkers, Placements, Stats)
            Continue For
        End If

        ' Part validation
        Stats.TotalParts += 1
        Dim PartDoc As Inventor.PartDocument = CType(Occ.Definition.Document, Inventor.PartDocument)
        Dim PartName As String = System.IO.Path.GetFileNameWithoutExtension(PartDoc.FullFileName)

        Dim CompType As String = ""
        If Not TryParsePartType(PartName, CompType) Then
            Stats.InvalidNames += 1
            Logger.Warning("Invalid part filename format: " & PartName)
            Continue For
        End If

        If CompType <> NibConfig.PlateComponentType Then Continue For
        Stats.PLComponents += 1

        If Not (TypeOf PartDoc.ComponentDefinition Is Inventor.SheetMetalComponentDefinition) Then
            Logger.Warning("PL part is not sheet metal: " & PartName)
            Continue For
        End If
        Stats.SheetMetalParts += 1

        Dim ParamThicknessMM As Double = 0
        Dim PhysicalThicknessMM As Double = GetPhysicalPlateThicknessMM(PartDoc, ParamThicknessMM)
        If PhysicalThicknessMM <= 0 Then
            Logger.Warning("Could not measure physical thickness: " & PartName)
            Continue For
        End If

        If ParamThicknessMM > 0 AndAlso Math.Abs(PhysicalThicknessMM - ParamThicknessMM) > NibConfig.ThicknessWarningToleranceMM Then
            Logger.Warning(PartName & ": Parameter thickness (" & Math.Round(ParamThicknessMM, 3) & _
                           " mm) differs from physical (" & Math.Round(PhysicalThicknessMM, 3) & " mm).")
        End If

        ' Resolve matching <Thickness>mm-STD-NIB.ipt for this plate
        Dim NibFilePath As String = ResolveNibForThickness(RootAssemblyDoc, PhysicalThicknessMM, NibCache)
        If String.IsNullOrWhiteSpace(NibFilePath) Then
            Logger.Warning(PartName & ": No matching nib file found for " & Math.Round(PhysicalThicknessMM, 2) & " mm plate. Skipped.")
            Continue For
        End If

        Stats.EligiblePlates += 1
        AnalyzePlateGeometry(PartDoc, Occ.Name, NibProfile, PhysicalThicknessMM, NibFilePath, CurrentTransform, _
                             InternalMarkers, ExternalMarkers, Placements)
    Next
End Sub


' ============================================================
' THICKNESS-BASED NIB RESOLVER
' ============================================================
Function ResolveNibForThickness( _
    AssemblyDoc As Inventor.AssemblyDocument, _
    PhysicalThicknessMM As Double, _
    NibCache As System.Collections.Generic.Dictionary(Of String, String)) As String

    ' Format thickness cleanly: e.g. 3.0 -> "3", 6.0 -> "6", 1.5 -> "1.5"
    Dim RoundedMM As Double = Math.Round(PhysicalThicknessMM, 1)
    Dim ThicknessLabel As String = RoundedMM.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)
    Dim TargetFileName As String = ThicknessLabel & NibConfig.NibFileSuffix

    If NibCache.ContainsKey(TargetFileName) Then
        Return NibCache(TargetFileName)
    End If

    Dim FoundPath As String = ""

    ' 1. Check active assembly's local folder first
    Try
        If AssemblyDoc IsNot Nothing AndAlso Not String.IsNullOrWhiteSpace(AssemblyDoc.FullFileName) Then
            Dim AsmFolder As String = System.IO.Path.GetDirectoryName(AssemblyDoc.FullFileName)
            Dim LocalPath As String = System.IO.Path.Combine(AsmFolder, TargetFileName)
            If System.IO.File.Exists(LocalPath) Then
                FoundPath = LocalPath
                Logger.Info("Resolved local nib for " & ThicknessLabel & " mm: " & FoundPath)
            End If
        End If
    Catch
    End Try

    ' 2. Check central shared network folder
    If String.IsNullOrWhiteSpace(FoundPath) Then
        Try
            If Not String.IsNullOrWhiteSpace(NibConfig.CentralNibFolder) Then
                Dim CentralPath As String = System.IO.Path.Combine(NibConfig.CentralNibFolder, TargetFileName)
                If System.IO.File.Exists(CentralPath) Then
                    FoundPath = CentralPath
                    Logger.Info("Resolved central nib for " & ThicknessLabel & " mm: " & FoundPath)
                End If
            End If
        Catch
        End Try
    End If

    ' Cache result (even if empty) so we only check disk once per thickness
    NibCache(TargetFileName) = FoundPath
    Return FoundPath
End Function


' ============================================================
' PLATE BOUNDARY & CURVE ANALYSIS
' ============================================================
Sub AnalyzePlateGeometry( _
    PartDoc As Inventor.PartDocument, _
    OccurrenceName As String, _
    NibProfile As String, _
    PhysicalThicknessMM As Double, _
    NibFilePath As String, _
    OccurrenceTransform As Inventor.Matrix, _
    InternalMarkers As System.Collections.Generic.List(Of Double), _
    ExternalMarkers As System.Collections.Generic.List(Of Double), _
    Placements As System.Collections.Generic.List(Of NibPlacement))

    Logger.Section("ANALYSING PLATE: " & OccurrenceName & " (" & System.IO.Path.GetFileName(NibFilePath) & ")")
    Dim PartDef As Inventor.PartComponentDefinition = CType(PartDoc.ComponentDefinition, Inventor.PartComponentDefinition)
    Dim ThicknessScaleThresholdMM As Double = Math.Max(PhysicalThicknessMM * 2.0, 1.0)

    For Each Body As Inventor.SurfaceBody In PartDef.SurfaceBodies
        If Body Is Nothing OrElse Not Body.IsSolid Then Continue For

        Dim MainFace As Inventor.Face = Nothing
        Dim BestLongEdgeCount As Integer = -1
        Dim BestFaceArea As Double = -1

        For Each Face As Inventor.Face In Body.Faces
            If Face Is Nothing OrElse Face.SurfaceType <> Inventor.SurfaceTypeEnum.kPlaneSurface Then Continue For
            Dim Area As Double = Face.Evaluator.Area
            Dim LongEdges As Integer = CountLongBoundaryEdges(PartDoc, Face, ThicknessScaleThresholdMM)
            If LongEdges > BestLongEdgeCount OrElse (LongEdges = BestLongEdgeCount AndAlso Area > BestFaceArea) Then
                MainFace = Face
                BestLongEdgeCount = LongEdges
                BestFaceArea = Area
            End If
        Next

        If MainFace Is Nothing Then Continue For

        For Each BoundaryLoop As Inventor.EdgeLoop In MainFace.EdgeLoops
            Dim IsOuter As Boolean = BoundaryLoop.IsOuterEdgeLoop
            Dim IncludeLoop As Boolean = False
            Select Case NibProfile
                Case "Internal openings - all suitable edges", "Internal openings - long edges only" : IncludeLoop = Not IsOuter
                Case "Internal openings + external perimeter" : IncludeLoop = True
                Case "External perimeter only" : IncludeLoop = IsOuter
            End Select
            If Not IncludeLoop Then Continue For

            Dim LongestEdgeMM As Double = 0
            For Each Edge As Inventor.Edge In BoundaryLoop.Edges
                LongestEdgeMM = Math.Max(LongestEdgeMM, GetCurveEdgeLengthMM(PartDoc, Edge))
            Next

            For Each Edge As Inventor.Edge In BoundaryLoop.Edges
                If Not IsSupportedEdgeCurve(Edge) Then Continue For

                Dim EdgeLengthMM As Double = GetCurveEdgeLengthMM(PartDoc, Edge)
                Dim IsClosed As Boolean = IsClosedEdgeCurve(Edge)
                Dim OrientationClass As String = ClassifyEdgeAgainstFaceNormal(MainFace, Edge, NibConfig.OrientationToleranceDegrees)

                If OrientationClass <> "IN-PLANE" Then Continue For
                If PhysicalThicknessMM > 0 AndAlso EdgeLengthMM <= PhysicalThicknessMM * 1.5 Then Continue For
                If EdgeLengthMM < NibConfig.MinimumNibEdgeLengthMM Then Continue For

                Dim EndClearanceMM As Double = If(IsClosed, 0.0, If(IsOuter, NibConfig.ExternalEndClearanceMM, NibConfig.InternalEndClearanceMM))
                Dim MinUsableMM As Double = If(IsOuter, NibConfig.ExternalMinimumUsableLengthMM, NibConfig.InternalMinimumUsableLengthMM)
                Dim UsableLengthMM As Double = EdgeLengthMM - (2.0 * EndClearanceMM)

                If UsableLengthMM < MinUsableMM Then Continue For
                If NibProfile = "Internal openings - long edges only" AndAlso EdgeLengthMM < (LongestEdgeMM * NibConfig.LongEdgeThresholdRatio) Then Continue For

                Dim IntervalCount As Integer = CInt(Math.Ceiling(UsableLengthMM / NibConfig.MaximumNibSpacingMM))
                If IsClosed AndAlso IntervalCount < 2 Then IntervalCount = 2
                If IntervalCount < 1 Then IntervalCount = 1

                Dim ActualSpacingMM As Double = UsableLengthMM / IntervalCount
                If ActualSpacingMM < NibConfig.MinimumNibCentreSeparationMM Then
                    Logger.Info("Rejected edge (spacing " & Math.Round(ActualSpacingMM, 1) & " mm < min separation).")
                    Continue For
                End If

                Dim MaxIndex As Integer = If(IsClosed, IntervalCount - 1, IntervalCount)
                For PosIndex As Integer = 0 To MaxIndex
                    Dim DistanceMM As Double = EndClearanceMM + (PosIndex * ActualSpacingMM)
                    AddNibPlacementAndMarker( _
                        PartDoc, MainFace, Edge, DistanceMM, PhysicalThicknessMM, NibFilePath, _
                        OccurrenceTransform, IsOuter, InternalMarkers, ExternalMarkers, Placements)
                Next
            Next
        Next
    Next
End Sub


' ============================================================
' NIB PLACEMENT FRAME & MARKER CALCULATION
' ============================================================
Sub AddNibPlacementAndMarker( _
    PartDoc As Inventor.PartDocument, _
    BroadFace As Inventor.Face, _
    Edge As Inventor.Edge, _
    DistanceAlongEdgeMM As Double, _
    PhysicalThicknessMM As Double, _
    NibFilePath As String, _
    OccurrenceTransform As Inventor.Matrix, _
    IsOuterLoop As Boolean, _
    InternalMarkers As System.Collections.Generic.List(Of Double), _
    ExternalMarkers As System.Collections.Generic.List(Of Double), _
    Placements As System.Collections.Generic.List(Of NibPlacement))

    Try
        Dim EdgePoint As Inventor.Point = Nothing
        Dim Tangent As Inventor.Vector = Nothing
        If Not TryEvaluateEdgeAtDistanceMM(PartDoc, Edge, DistanceAlongEdgeMM, EdgePoint, Tangent) Then Exit Sub

        If NibConfig.ShowCandidateMarkers Then
            Dim MarkerPt As Inventor.Point = EdgePoint.Copy()
            MarkerPt.TransformBy(OccurrenceTransform)
            Dim TargetList = If(IsOuterLoop, ExternalMarkers, InternalMarkers)
            TargetList.Add(MarkerPt.X) : TargetList.Add(MarkerPt.Y) : TargetList.Add(MarkerPt.Z)
        End If

        Dim FaceEval As Inventor.SurfaceEvaluator = BroadFace.Evaluator
        Dim PtArr() As Double = {EdgePoint.X, EdgePoint.Y, EdgePoint.Z}
        Dim Guess() As Double = {}, MaxDev() As Double = {}, Params() As Double = {}, SolNatures() As Inventor.SolutionNatureEnum = {}
        FaceEval.GetParamAtPoint(PtArr, Guess, MaxDev, Params, SolNatures)

        Dim Normals() As Double = {}
        FaceEval.GetNormal(Params, Normals)
        Dim OutwardFaceNormal As Inventor.Vector = ThisApplication.TransientGeometry.CreateVector(Normals(0), Normals(1), Normals(2))
        If OutwardFaceNormal.Length < 0.000001 Then Exit Sub
        OutwardFaceNormal.Normalize()

        Dim OutwardEdge As Inventor.Vector = ThisApplication.TransientGeometry.CreateVector( _
            (Tangent.Y * OutwardFaceNormal.Z) - (Tangent.Z * OutwardFaceNormal.Y), _
            (Tangent.Z * OutwardFaceNormal.X) - (Tangent.X * OutwardFaceNormal.Z), _
            (Tangent.X * OutwardFaceNormal.Y) - (Tangent.Y * OutwardFaceNormal.X))
        If OutwardEdge.Length < 0.000001 Then Exit Sub
        OutwardEdge.Normalize()

        Dim ProbePt As Inventor.Point = ThisApplication.TransientGeometry.CreatePoint( _
            EdgePoint.X + (OutwardEdge.X * 0.05), _
            EdgePoint.Y + (OutwardEdge.Y * 0.05), _
            EdgePoint.Z + (OutwardEdge.Z * 0.05))
        If ProbePt.DistanceTo(BroadFace.GetClosestPointTo(ProbePt)) < 0.01 Then
            OutwardEdge.ScaleBy(-1.0)
        End If

        Dim YAxis As Inventor.Vector = OutwardEdge
        Dim XAxis As Inventor.Vector = OutwardFaceNormal
        Dim ZAxis As Inventor.Vector = ThisApplication.TransientGeometry.CreateVector( _
            (XAxis.Y * YAxis.Z) - (XAxis.Z * YAxis.Y), _
            (XAxis.Z * YAxis.X) - (XAxis.X * YAxis.Z), _
            (XAxis.X * YAxis.Y) - (XAxis.Y * YAxis.X))
        If ZAxis.Length < 0.000001 Then Exit Sub
        ZAxis.Normalize()

        Dim HalfThickCM As Double = PartDoc.UnitsOfMeasure.ConvertUnits(PhysicalThicknessMM / 2.0, "mm", "cm")
        Dim OriginPart As Inventor.Point = ThisApplication.TransientGeometry.CreatePoint( _
            EdgePoint.X - (XAxis.X * HalfThickCM), _
            EdgePoint.Y - (XAxis.Y * HalfThickCM), _
            EdgePoint.Z - (XAxis.Z * HalfThickCM))

        Dim O As Inventor.Point = OriginPart.Copy() : O.TransformBy(OccurrenceTransform)
        Dim XP As Inventor.Point = ThisApplication.TransientGeometry.CreatePoint(OriginPart.X + XAxis.X, OriginPart.Y + XAxis.Y, OriginPart.Z + XAxis.Z) : XP.TransformBy(OccurrenceTransform)
        Dim YP As Inventor.Point = ThisApplication.TransientGeometry.CreatePoint(OriginPart.X + YAxis.X, OriginPart.Y + YAxis.Y, OriginPart.Z + YAxis.Z) : YP.TransformBy(OccurrenceTransform)
        Dim ZP As Inventor.Point = ThisApplication.TransientGeometry.CreatePoint(OriginPart.X + ZAxis.X, OriginPart.Y + ZAxis.Y, OriginPart.Z + ZAxis.Z) : ZP.TransformBy(OccurrenceTransform)

        Dim AX As Inventor.Vector = ThisApplication.TransientGeometry.CreateVector(XP.X - O.X, XP.Y - O.Y, XP.Z - O.Z) : AX.Normalize()
        Dim AY As Inventor.Vector = ThisApplication.TransientGeometry.CreateVector(YP.X - O.X, YP.Y - O.Y, YP.Z - O.Z) : AY.Normalize()
        Dim AZ As Inventor.Vector = ThisApplication.TransientGeometry.CreateVector(ZP.X - O.X, ZP.Y - O.Y, ZP.Z - O.Z) : AZ.Normalize()

        Dim P As New NibPlacement With { _
            .PlatePath = PartDoc.FullFileName, _
            .NibFilePath = NibFilePath, _
            .PartOrigin = OriginPart, .PartX = XAxis, .PartY = YAxis, .PartZ = ZAxis, _
            .AsmOrigin = O, .AsmX = AX, .AsmY = AY, .AsmZ = AZ, _
            .StagingIndex = Placements.Count}
        Placements.Add(P)
    Catch ex As Exception
        Logger.Debug("Nib frame calculation failed: " & ex.Message)
    End Try
End Sub


' ============================================================
' STAGING OCCURRENCES & TRANSIENT B-REP SOLID JOIN
' ============================================================
Function CreateNibStagingOccurrences( _
    AssemblyDoc As Inventor.AssemblyDocument, _
    Placements As System.Collections.Generic.List(Of NibPlacement), _
    StagingOccurrences As System.Collections.Generic.List(Of Inventor.ComponentOccurrence)) As Boolean

    Dim ToCreate As Integer = Math.Min(Placements.Count, NibConfig.MaxStagingOccurrences)
    Dim OverlapCM As Double = AssemblyDoc.UnitsOfMeasure.ConvertUnits(NibConfig.NibJoinOverlapMM, "mm", "cm")
    Dim Failed As Integer = 0

    For i As Integer = 0 To ToCreate - 1
        Try
            Dim P As NibPlacement = Placements(i)
            Dim OverlappedOrigin As Inventor.Point = ThisApplication.TransientGeometry.CreatePoint( _
                P.AsmOrigin.X - (P.AsmY.X * OverlapCM), _
                P.AsmOrigin.Y - (P.AsmY.Y * OverlapCM), _
                P.AsmOrigin.Z - (P.AsmY.Z * OverlapCM))
            Dim M As Inventor.Matrix = ThisApplication.TransientGeometry.CreateMatrix()
            M.SetCoordinateSystem(OverlappedOrigin, P.AsmX, P.AsmY, P.AsmZ)

            Dim Occ As Inventor.ComponentOccurrence = AssemblyDoc.ComponentDefinition.Occurrences.Add(P.NibFilePath, M)
            If Occ Is Nothing Then Throw New Exception("Occurrences.Add returned Nothing.")
            StagingOccurrences.Add(Occ)
        Catch ex As Exception
            Failed += 1
            Logger.Error("Staging occurrence failed (" & (i + 1) & "): " & ex.Message)
        End Try
    Next

    ThisApplication.ActiveView.Update()
    Return (StagingOccurrences.Count > 0 AndAlso Failed = 0)
End Function

Sub GenerateNibGeometryInPlateParts( _
    Placements As System.Collections.Generic.List(Of NibPlacement), _
    StagingOccurrences As System.Collections.Generic.List(Of Inventor.ComponentOccurrence))

    ' Validate each unique nib file once and cache its thickness
    Dim NibThicknessCache As New System.Collections.Generic.Dictionary(Of String, Double)(StringComparer.OrdinalIgnoreCase)

    Dim ProcessedFiles As New System.Collections.Generic.HashSet(Of String)(StringComparer.OrdinalIgnoreCase)

    For Each P As NibPlacement In Placements
        If ProcessedFiles.Contains(P.PlatePath) Then Continue For
        ProcessedFiles.Add(P.PlatePath)

        Dim NibThicknessMM As Double = 0
        If Not NibThicknessCache.TryGetValue(P.NibFilePath, NibThicknessMM) Then
            NibThicknessMM = ValidateAndGetNibThicknessMM(P.NibFilePath)
            NibThicknessCache(P.NibFilePath) = NibThicknessMM
        End If
        If NibThicknessMM <= 0 Then Continue For

        Dim PlateRecords As New System.Collections.Generic.List(Of NibPlacement)
        For Each Candidate As NibPlacement In Placements
            If String.Equals(Candidate.PlatePath, P.PlatePath, StringComparison.OrdinalIgnoreCase) Then PlateRecords.Add(Candidate)
        Next

        Dim PlateDoc As Inventor.PartDocument = CType(ThisApplication.Documents.Open(P.PlatePath, False), Inventor.PartDocument)
        Dim PlateDef As Inventor.PartComponentDefinition = CType(PlateDoc.ComponentDefinition, Inventor.PartComponentDefinition)

        Dim AlreadyGenerated As Boolean = False
        For Each JoinFeat As Inventor.CombineFeature In PlateDef.Features.CombineFeatures
            If JoinFeat.Name.StartsWith("NIB_AUTO_JOIN_", StringComparison.OrdinalIgnoreCase) Then AlreadyGenerated = True : Exit For
        Next
        If AlreadyGenerated Then Continue For

        Dim DummyParam As Double = 0
        Dim PlateThicknessMM As Double = GetPhysicalPlateThicknessMM(PlateDoc, DummyParam)
        If PlateThicknessMM <= 0 OrElse Math.Abs(PlateThicknessMM - NibThicknessMM) > NibConfig.NibThicknessMatchToleranceMM Then
            Logger.Error("Thickness mismatch between " & System.IO.Path.GetFileName(P.PlatePath) & " and " & System.IO.Path.GetFileName(P.NibFilePath))
            Continue For
        End If

        Dim BaseBody As Inventor.SurfaceBody = GetSingleSolidBody(PlateDef)
        If BaseBody Is Nothing Then
            Logger.Error("Expected single solid body in: " & System.IO.Path.GetFileName(P.PlatePath))
            Continue For
        End If

        Dim UniqueRecords As New System.Collections.Generic.List(Of NibPlacement)
        Dim SeenKeys As New System.Collections.Generic.HashSet(Of String)
        For Each Rec As NibPlacement In PlateRecords
            Dim Key As String = Math.Round(Rec.PartOrigin.X, 4) & "|" & Math.Round(Rec.PartOrigin.Y, 4) & "|" & Math.Round(Rec.PartOrigin.Z, 4)
            If SeenKeys.Add(Key) Then UniqueRecords.Add(Rec)
        Next

        Dim Tx As Inventor.Transaction = Nothing
        Dim Succeeded As Boolean = False
        Dim OverlapCM As Double = PlateDoc.UnitsOfMeasure.ConvertUnits(NibConfig.NibJoinOverlapMM, "mm", "cm")

        Try
            Tx = ThisApplication.TransactionManager.StartTransaction(PlateDoc, "Inventor Nib Automation - Generate Nibs")

            For i As Integer = 0 To UniqueRecords.Count - 1
                Dim Rec As NibPlacement = UniqueRecords(i)
                Dim SourceOcc As Inventor.ComponentOccurrence = StagingOccurrences(Rec.StagingIndex)
                Dim SourceBody As Inventor.SurfaceBody = GetSingleSolidBody(CType(SourceOcc.Definition, Inventor.PartComponentDefinition))

                Dim CopiedBody As Inventor.SurfaceBody = ThisApplication.TransientBRep.Copy(SourceBody)
                Dim OverlappedOrigin As Inventor.Point = ThisApplication.TransientGeometry.CreatePoint( _
                    Rec.PartOrigin.X - (Rec.PartY.X * OverlapCM), _
                    Rec.PartOrigin.Y - (Rec.PartY.Y * OverlapCM), _
                    Rec.PartOrigin.Z - (Rec.PartY.Z * OverlapCM))

                Dim M As Inventor.Matrix = ThisApplication.TransientGeometry.CreateMatrix()
                M.SetCoordinateSystem(OverlappedOrigin, Rec.PartX, Rec.PartY, Rec.PartZ)
                ThisApplication.TransientBRep.Transform(CopiedBody, M)

                Dim BaseDef As Inventor.NonParametricBaseFeatureDefinition = PlateDef.Features.NonParametricBaseFeatures.CreateDefinition()
                Dim Entities As Inventor.ObjectCollection = ThisApplication.TransientObjects.CreateObjectCollection()
                Entities.Add(CopiedBody)
                BaseDef.BRepEntities = Entities
                BaseDef.OutputType = Inventor.BaseFeatureOutputTypeEnum.kSolidOutputType
                BaseDef.IsAssociative = False

                Dim BaseFeat As Inventor.NonParametricBaseFeature = PlateDef.Features.NonParametricBaseFeatures.AddByDefinition(BaseDef)
                BaseFeat.Name = "NIB_AUTO_BODY_" & (i + 1).ToString("0000")

                Dim ToolBodies As Inventor.ObjectCollection = ThisApplication.TransientObjects.CreateObjectCollection()
                ToolBodies.Add(BaseFeat.SurfaceBodies(1))

                Dim JoinFeat As Inventor.CombineFeature = PlateDef.Features.CombineFeatures.Add( _
                    BaseBody, ToolBodies, Inventor.PartFeatureOperationEnum.kJoinOperation, False)
                JoinFeat.Name = "NIB_AUTO_JOIN_" & (i + 1).ToString("0000")
                BaseBody = JoinFeat.SurfaceBodies(1)
            Next

            PlateDoc.Update2(True)
            Tx.End()
            Succeeded = True
            Logger.Success("Generated " & UniqueRecords.Count & " nibs on: " & System.IO.Path.GetFileName(P.PlatePath))

        Catch ex As Exception
            Logger.Error("Failed generating nibs on " & System.IO.Path.GetFileName(P.PlatePath) & ": " & ex.Message)
            If Tx IsNot Nothing Then Try : Tx.Abort() : Catch : End Try
        End Try

        If Succeeded Then
            For Each Completed As NibPlacement In PlateRecords
                Dim Idx As Integer = Completed.StagingIndex
                If Idx >= 0 AndAlso Idx < StagingOccurrences.Count AndAlso StagingOccurrences(Idx) IsNot Nothing Then
                    Try : StagingOccurrences(Idx).Delete() : StagingOccurrences(Idx) = Nothing : Catch : End Try
                End If
            Next
        End If
    Next

    Try : ThisApplication.ActiveView.Update() : Catch : End Try
End Sub

Function ValidateAndGetNibThicknessMM(NibFilePath As String) As Double
    Try
        Dim NibDoc As Inventor.PartDocument = CType(ThisApplication.Documents.Open(NibFilePath, False), Inventor.PartDocument)
        Dim NibBody As Inventor.SurfaceBody = GetSingleSolidBody(CType(NibDoc.ComponentDefinition, Inventor.PartComponentDefinition))
        If NibBody Is Nothing Then
            Logger.Error("Nib reference must contain a single solid body: " & NibFilePath)
            Return -1
        End If

        Dim NibThicknessMM As Double = NibDoc.UnitsOfMeasure.ConvertUnits(Math.Abs(NibBody.RangeBox.MaxPoint.X - NibBody.RangeBox.MinPoint.X), "cm", "mm")
        Dim NibMinYMM As Double = NibDoc.UnitsOfMeasure.ConvertUnits(NibBody.RangeBox.MinPoint.Y, "cm", "mm")
        Dim NibMaxYMM As Double = NibDoc.UnitsOfMeasure.ConvertUnits(NibBody.RangeBox.MaxPoint.Y, "cm", "mm")
        If Math.Abs(NibMinYMM) > 0.1 OrElse NibMaxYMM <= NibMinYMM Then
            Logger.Error("Nib solid must start at ZX plane (Y ~ 0) and project toward +Y: " & NibFilePath)
            Return -1
        End If
        Return NibThicknessMM
    Catch ex As Exception
        Logger.Error("Failed validating nib file " & NibFilePath & ": " & ex.Message)
        Return -1
    End Try
End Function


' ============================================================
' CURVE & SOLID GEOMETRY HELPERS
' ============================================================
Function IsSupportedEdgeCurve(Edge As Inventor.Edge) As Boolean
    If Edge Is Nothing Then Return False
    Select Case Edge.GeometryType
        Case Inventor.CurveTypeEnum.kLineSegmentCurve, Inventor.CurveTypeEnum.kCircularArcCurve, _
             Inventor.CurveTypeEnum.kCircleCurve, Inventor.CurveTypeEnum.kEllipticalArcCurve, _
             Inventor.CurveTypeEnum.kEllipseFullCurve, Inventor.CurveTypeEnum.kBSplineCurve
            Return True
        Case Else
            Return False
    End Select
End Function

Function IsClosedEdgeCurve(Edge As Inventor.Edge) As Boolean
    If Edge.GeometryType = Inventor.CurveTypeEnum.kCircleCurve OrElse Edge.GeometryType = Inventor.CurveTypeEnum.kEllipseFullCurve Then Return True
    Dim Eval As Inventor.CurveEvaluator = Edge.Evaluator
    Dim MinP As Double = 0, MaxP As Double = 0
    Eval.GetParamExtents(MinP, MaxP)
    Dim Pts() As Double = {}
    Eval.GetPointAtParam(New Double() {MinP, MaxP}, Pts)
    Return Math.Sqrt(((Pts(3) - Pts(0)) ^ 2) + ((Pts(4) - Pts(1)) ^ 2) + ((Pts(5) - Pts(2)) ^ 2)) < 0.0001
End Function

Function GetCurveEdgeLengthMM(PartDoc As Inventor.PartDocument, Edge As Inventor.Edge) As Double
    If Not IsSupportedEdgeCurve(Edge) Then Return 0
    Dim Eval As Inventor.CurveEvaluator = Edge.Evaluator
    Dim MinP As Double = 0, MaxP As Double = 0, LengthCM As Double = 0
    Eval.GetParamExtents(MinP, MaxP)
    Eval.GetLengthAtParam(MinP, MaxP, LengthCM)
    Return PartDoc.UnitsOfMeasure.ConvertUnits(LengthCM, "cm", "mm")
End Function

Function TryEvaluateEdgeAtDistanceMM( _
    PartDoc As Inventor.PartDocument, Edge As Inventor.Edge, DistanceMM As Double, _
    ByRef OutPoint As Inventor.Point, ByRef OutTangent As Inventor.Vector) As Boolean

    Try
        Dim Eval As Inventor.CurveEvaluator = Edge.Evaluator
        Dim MinP As Double = 0, MaxP As Double = 0
        Eval.GetParamExtents(MinP, MaxP)
        Dim DistCM As Double = PartDoc.UnitsOfMeasure.ConvertUnits(DistanceMM, "mm", "cm")
        Dim TargetP As Double = MinP
        If DistCM > 0 Then Eval.GetParamAtLength(MinP, DistCM, TargetP)

        Dim Pts() As Double = {}, Tans() As Double = {}
        Eval.GetPointAtParam(New Double() {TargetP}, Pts)
        Eval.GetTangent(New Double() {TargetP}, Tans)

        OutPoint = ThisApplication.TransientGeometry.CreatePoint(Pts(0), Pts(1), Pts(2))
        OutTangent = ThisApplication.TransientGeometry.CreateVector(Tans(0), Tans(1), Tans(2))
        If OutTangent.Length < 0.000001 Then Return False
        OutTangent.Normalize()
        Return True
    Catch
        Return False
    End Try
End Function

Function ClassifyEdgeAgainstFaceNormal(Face As Inventor.Face, Edge As Inventor.Edge, ToleranceDeg As Double) As String
    Try
        Dim FaceNormal As Inventor.UnitVector = CType(Face.Geometry, Inventor.Plane).Normal
        Dim Eval As Inventor.CurveEvaluator = Edge.Evaluator
        Dim MinP As Double = 0, MaxP As Double = 0
        Eval.GetParamExtents(MinP, MaxP)

        Dim MaxDot As Double = 0
        For Each F As Double In New Double() {0.1, 0.5, 0.9}
            Dim Tans() As Double = {}
            Eval.GetTangent(New Double() {MinP + ((MaxP - MinP) * F)}, Tans)
            Dim Mag As Double = Math.Sqrt((Tans(0) ^ 2) + (Tans(1) ^ 2) + (Tans(2) ^ 2))
            If Mag < 0.000001 Then Return "UNAVAILABLE"
            MaxDot = Math.Max(MaxDot, Math.Abs(((FaceNormal.X * Tans(0)) + (FaceNormal.Y * Tans(1)) + (FaceNormal.Z * Tans(2))) / Mag))
        Next

        Dim TolRad As Double = ToleranceDeg * Math.PI / 180.0
        If MaxDot <= Math.Sin(TolRad) Then Return "IN-PLANE"
        If MaxDot >= Math.Cos(TolRad) Then Return "THICKNESS-DIRECTION"
        Return "AMBIGUOUS"
    Catch
        Return "UNAVAILABLE"
    End Try
End Function

Function CountLongBoundaryEdges(PartDoc As Inventor.PartDocument, Face As Inventor.Face, MinLengthMM As Double) As Integer
    Dim Count As Integer = 0
    For Each LoopObj As Inventor.EdgeLoop In Face.EdgeLoops
        For Each Edge As Inventor.Edge In LoopObj.Edges
            If GetCurveEdgeLengthMM(PartDoc, Edge) > MinLengthMM Then Count += 1
        Next
    Next
    Return Count
End Function

Function GetSingleSolidBody(PartDef As Inventor.PartComponentDefinition) As Inventor.SurfaceBody
    Dim Found As Inventor.SurfaceBody = Nothing
    For Each B As Inventor.SurfaceBody In PartDef.SurfaceBodies
        If B IsNot Nothing AndAlso B.IsSolid Then
            If Found IsNot Nothing Then Return Nothing
            Found = B
        End If
    Next
    Return Found
End Function

Function GetPhysicalPlateThicknessMM(PartDoc As Inventor.PartDocument, ByRef ParamThicknessMM As Double) As Double
    Try
        Dim SMDef As Inventor.SheetMetalComponentDefinition = CType(PartDoc.ComponentDefinition, Inventor.SheetMetalComponentDefinition)
        Try : ParamThicknessMM = PartDoc.UnitsOfMeasure.ConvertUnits(SMDef.Thickness.Value, "cm", "mm") : Catch : End Try

        Dim Box As Inventor.OrientedBox = CType(PartDoc.ComponentDefinition, Inventor.PartComponentDefinition).OrientedMinimumRangeBox
        Dim D1 As Double = PartDoc.UnitsOfMeasure.ConvertUnits(Box.DirectionOne.Length, "cm", "mm")
        Dim D2 As Double = PartDoc.UnitsOfMeasure.ConvertUnits(Box.DirectionTwo.Length, "cm", "mm")
        Dim D3 As Double = PartDoc.UnitsOfMeasure.ConvertUnits(Box.DirectionThree.Length, "cm", "mm")
        Return Math.Min(D1, Math.Min(D2, D3))
    Catch
        Return 0
    End Try
End Function

Function TryParsePartType(Name As String, ByRef ComponentType As String) As Boolean
    Dim M = System.Text.RegularExpressions.Regex.Match(Name, "^[0-9]{4}-[A-Za-z]{3}-([A-Za-z]{2})[0-9]{2}-[0-9]{2}$")
    If Not M.Success Then Return False
    ComponentType = M.Groups(1).Value.ToUpper()
    Return True
End Function


' ============================================================
' CLIENT GRAPHICS MARKERS (CONTROLLED BY NibConfig.ShowCandidateMarkers)
' ============================================================
Sub UpdateCandidateMarkers( _
    AssemblyDoc As Inventor.AssemblyDocument, _
    InternalCoords As System.Collections.Generic.List(Of Double), _
    ExternalCoords As System.Collections.Generic.List(Of Double))

    Const GraphicsId As String = "InventorNibAutomation_CandidateMarkers"
    Try
        Try : AssemblyDoc.ComponentDefinition.ClientGraphicsCollection.Item(GraphicsId).Delete() : Catch : End Try
        Try : AssemblyDoc.GraphicsDataSetsCollection.Item(GraphicsId).Delete() : Catch : End Try

        If Not NibConfig.ShowCandidateMarkers OrElse (InternalCoords.Count = 0 AndAlso ExternalCoords.Count = 0) Then
            ThisApplication.ActiveView.Update()
            Exit Sub
        End If

        Dim DataSets As Inventor.GraphicsDataSets = AssemblyDoc.GraphicsDataSetsCollection.Add(GraphicsId)
        Dim Graphics As Inventor.ClientGraphics = AssemblyDoc.ComponentDefinition.ClientGraphicsCollection.Add(GraphicsId)

        If InternalCoords.Count > 0 Then DrawCrossGroup(DataSets, Graphics, InternalCoords, 1, 0, 180, 255)
        If ExternalCoords.Count > 0 Then DrawCrossGroup(DataSets, Graphics, ExternalCoords, 2, 255, 140, 0)
        ThisApplication.ActiveView.Update()
    Catch
    End Try
End Sub

Sub DrawCrossGroup( _
    DataSets As Inventor.GraphicsDataSets, Graphics As Inventor.ClientGraphics, _
    Coords As System.Collections.Generic.List(Of Double), NodeId As Integer, R As Integer, G As Integer, B As Integer)

    Dim Lines As New System.Collections.Generic.List(Of Double)
    Dim H As Double = 0.1
    For i As Integer = 0 To Coords.Count - 1 Step 3
        Dim X As Double = Coords(i), Y As Double = Coords(i + 1), Z As Double = Coords(i + 2)
        Lines.AddRange(New Double() {X - H, Y, Z, X + H, Y, Z, X, Y - H, Z, X, Y + H, Z, X, Y, Z - H, X, Y, Z + H})
    Next

    Dim CoordSet As Inventor.GraphicsCoordinateSet = DataSets.CreateCoordinateSet(NodeId)
    CoordSet.PutCoordinates(Lines.ToArray())
    Dim Node As Inventor.GraphicsNode = Graphics.AddNode(NodeId)
    Node.Selectable = False
    Dim LineGfx As Inventor.LineGraphics = Node.AddLineGraphics()
    LineGfx.CoordinateSet = CoordSet
    Dim ColorSet As Inventor.GraphicsColorSet = DataSets.CreateColorSet(NodeId)
    ColorSet.Add(1, R, G, B)
    LineGfx.ColorSet = ColorSet
End Sub


' ============================================================
' SILENT FILE LOGGER (CONTROLLED BY NibConfig.EnableDiagnosticLog)
' ============================================================
Sub SaveLogIfEnabled(AssemblyDoc As Inventor.AssemblyDocument)
    If Not NibConfig.EnableDiagnosticLog Then Exit Sub
    Try
        Dim Folder As String = If(AssemblyDoc IsNot Nothing AndAlso Not String.IsNullOrWhiteSpace(AssemblyDoc.FullFileName), _
                                  System.IO.Path.GetDirectoryName(AssemblyDoc.FullFileName), _
                                  System.IO.Path.GetTempPath())
        Dim BaseName As String = If(AssemblyDoc IsNot Nothing, _
                                    System.IO.Path.GetFileNameWithoutExtension(AssemblyDoc.FullFileName), _
                                    "NibAutomation")
        Dim LogPath As String = System.IO.Path.Combine(Folder, BaseName & "_NibLog_" & DateTime.Now.ToString("yyyyMMdd_HHmmss") & ".log")
        System.IO.File.WriteAllText(LogPath, Logger.GetText())
    Catch
    End Try
End Sub

Class Logger
    Private Shared Lines As New System.Collections.Generic.List(Of String)

    Public Shared Sub Start()
        Lines.Clear()
        WriteRaw("INVENTOR NIB AUTOMATION LOG - " & DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))
    End Sub

    Public Shared Sub Section(Title As String)
        If Not NibConfig.EnableDiagnosticLog Then Exit Sub
        WriteRaw(vbCrLf & "--- " & Title & " ---")
    End Sub

    Public Shared Sub Info(Msg As String) : Log("INFO", Msg) : End Sub
    Public Shared Sub Success(Msg As String) : Log("SUCCESS", Msg) : End Sub
    Public Shared Sub Warning(Msg As String) : Log("WARNING", Msg) : End Sub
    Public Shared Sub [Error](Msg As String) : Log("ERROR", Msg) : End Sub
    Public Shared Sub Debug(Msg As String) : Log("DEBUG", Msg) : End Sub

    Private Shared Sub Log(Level As String, Msg As String)
        If Not NibConfig.EnableDiagnosticLog Then Exit Sub
        Lines.Add(String.Format("[{0}] {1,-9} {2}", DateTime.Now.ToString("HH:mm:ss"), "[" & Level & "]", Msg))
    End Sub

    Private Shared Sub WriteRaw(Text As String)
        If NibConfig.EnableDiagnosticLog Then Lines.Add(Text)
    End Sub

    Public Shared Function GetText() As String
        Return String.Join(vbCrLf, Lines)
    End Function
End Class
