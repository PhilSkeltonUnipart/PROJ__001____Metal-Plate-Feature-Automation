' ============================================================
' INVENTOR ASSEMBLY / PLATE SCANNER
' With centralised Logger
' ============================================================

Imports System.IO
Imports System.Text.RegularExpressions
Imports Inventor

' ============================================================
' SETTINGS
' ============================================================

Dim PlateComponentType As String = "PL"

' Enable/disable detailed diagnostic messages
Dim DebugLogging As Boolean = True


' ============================================================
' LOGGER
' ============================================================

Class Logger

    Private Shared LogLines As New System.Collections.Generic.List(Of String)

    Public Shared Sub Start()

        LogLines.Clear()

        Add("============================================================")
        Add("INVENTOR NIB AUTOMATION LOG")
        Add("Started: " & DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))
        Add("============================================================")

    End Sub


    Public Shared Sub Info(Message As String)

        Add("[INFO]    " & Message)

    End Sub


    Public Shared Sub Success(Message As String)

        Add("[SUCCESS] " & Message)

    End Sub


    Public Shared Sub Warning(Message As String)

        Add("[WARNING] " & Message)

    End Sub


    Public Shared Sub [Error](Message As String)

        Add("[ERROR]   " & Message)

    End Sub


    Public Shared Sub Debug(Message As String)

        If DebugLogging Then
            Add("[DEBUG]   " & Message)
        End If

    End Sub


    Public Shared Sub Section(Name As String)

        Add("")
        Add("------------------------------------------------------------")
        Add(Name)
        Add("------------------------------------------------------------")

    End Sub


    Private Shared Sub Add(Message As String)

        Dim TimeStamp As String = DateTime.Now.ToString("HH:mm:ss")

        LogLines.Add("[" & TimeStamp & "] " & Message)

    End Sub


    Public Shared Function GetText() As String

        Return String.Join(vbCrLf, LogLines)

    End Function


    Public Shared Sub SaveToFile(FilePath As String)

        Try

            File.WriteAllText(FilePath, GetText())

        Catch ex As Exception

            ' Don't allow a logging failure to stop the automation
            MsgBox("Unable to save log file:" & vbCrLf & ex.Message)

        End Try

    End Sub

End Class


' ============================================================
' MAIN PROGRAM
' ============================================================

Sub Main()

    Logger.Start()

    Logger.Section("STARTING ASSEMBLY SCAN")

    Logger.Info("Inventor version: " & ThisApplication.SoftwareVersion)

    Dim ActiveDoc As Document = ThisApplication.ActiveDocument

    If ActiveDoc Is Nothing Then

        Logger.Error("No active document found.")

        ShowLog()

        Exit Sub

    End If


    Logger.Info("Active document: " & ActiveDoc.DisplayName)


    ' --------------------------------------------------------
    ' CHECK DOCUMENT TYPE
    ' --------------------------------------------------------

    If ActiveDoc.DocumentType <> DocumentTypeEnum.kAssemblyDocumentObject Then

        Logger.Error("Active document is not an assembly.")

        Logger.Info("Please open an assembly before running the scanner.")

        ShowLog()

        Exit Sub

    End If


    Dim AssemblyDoc As AssemblyDocument =
        CType(ActiveDoc, AssemblyDocument)


    ' --------------------------------------------------------
    ' ASSEMBLY NAME
    ' --------------------------------------------------------

    Logger.Section("ASSEMBLY INFORMATION")

    Dim AssemblyName As String =
        Path.GetFileNameWithoutExtension(AssemblyDoc.FullFileName)


    Logger.Info("Assembly filename: " & AssemblyName)


    Dim AssemblyData As AssemblyNameData =
        ParseAssemblyName(AssemblyName)


    If AssemblyData.IsValid Then

        Logger.Success("Assembly naming convention: PASS")

        Logger.Info("Project: " & AssemblyData.ProjectNumber)
        Logger.Info("Description: " & AssemblyData.Description)
        Logger.Info("Assembly type: " & AssemblyData.AssemblyType)
        Logger.Info("Assembly number: " & AssemblyData.AssemblyNumber)
        Logger.Info("Revision: " & AssemblyData.Revision)

    Else

        Logger.Warning("Assembly naming convention: FAIL")

    End If


    ' --------------------------------------------------------
    ' COUNTERS
    ' --------------------------------------------------------

    Dim TotalOccurrences As Integer = 0
    Dim TotalParts As Integer = 0
    Dim SheetMetalParts As Integer = 0
    Dim PLComponents As Integer = 0
    Dim EligiblePlates As Integer = 0
    Dim InvalidNames As Integer = 0
    Dim SubAssemblies As Integer = 0


    ' --------------------------------------------------------
    ' SCAN ASSEMBLY
    ' --------------------------------------------------------

    Logger.Section("SCANNING COMPONENTS")


    ScanOccurrences( _
        AssemblyDoc.ComponentDefinition.Occurrences, _
        TotalOccurrences, _
        TotalParts, _
        SheetMetalParts, _
        PLComponents, _
        EligiblePlates, _
        InvalidNames, _
        SubAssemblies)


    ' --------------------------------------------------------
    ' SUMMARY
    ' --------------------------------------------------------

    Logger.Section("SCAN SUMMARY")

    Logger.Info("Assemblies found: " & SubAssemblies)
    Logger.Info("Total occurrences: " & TotalOccurrences)
    Logger.Info("Total parts: " & TotalParts)
    Logger.Info("Sheet metal parts: " & SheetMetalParts)
    Logger.Info("PL components: " & PLComponents)
    Logger.Info("Eligible plates: " & EligiblePlates)
    Logger.Info("Invalid filenames: " & InvalidNames)


    Logger.Section("SCAN COMPLETE")

    Logger.Success("Assembly scan completed.")


    ' --------------------------------------------------------
    ' SHOW LOG
    ' --------------------------------------------------------

    ShowLog()


End Sub


' ============================================================
' RECURSIVE OCCURRENCE SCANNER
' ============================================================

Sub ScanOccurrences( _
    Occurrences As ComponentOccurrences, _
    ByRef TotalOccurrences As Integer, _
    ByRef TotalParts As Integer, _
    ByRef SheetMetalParts As Integer, _
    ByRef PLComponents As Integer, _
    ByRef EligiblePlates As Integer, _
    ByRef InvalidNames As Integer, _
    ByRef SubAssemblies As Integer)


    For Each Occurrence As ComponentOccurrence In Occurrences

        TotalOccurrences += 1


        Logger.Debug("Inspecting occurrence: " & Occurrence.Name)


        ' ====================================================
        ' SUPPRESSED COMPONENT
        ' ====================================================

        If Occurrence.Suppressed Then

            Logger.Warning( _
                Occurrence.Name & " is suppressed - skipped.")

            Continue For

        End If


        ' ====================================================
        ' ASSEMBLY
        ' ====================================================

        If Occurrence.DefinitionDocumentType = _
            DocumentTypeEnum.kAssemblyDocumentObject Then


            SubAssemblies += 1


            Dim SubAssemblyDoc As AssemblyDocument =
                CType(Occurrence.Definition.Document, AssemblyDocument)


            Dim SubAssemblyName As String =
                Path.GetFileNameWithoutExtension( _
                    SubAssemblyDoc.FullFileName)


            Logger.Section("SUBASSEMBLY")

            Logger.Info("Name: " & SubAssemblyName)


            Dim SubAssemblyData As AssemblyNameData =
                ParseAssemblyName(SubAssemblyName)


            If SubAssemblyData.IsValid Then

                Logger.Success("Naming convention: PASS")

                Logger.Debug( _
                    "Project: " & SubAssemblyData.ProjectNumber)

                Logger.Debug( _
                    "Description: " & SubAssemblyData.Description)

                Logger.Debug( _
                    "Type: " & SubAssemblyData.AssemblyType)

                Logger.Debug( _
                    "Number: " & SubAssemblyData.AssemblyNumber)

                Logger.Debug( _
                    "Revision: " & SubAssemblyData.Revision)

            Else

                Logger.Warning( _
                    "Subassembly naming convention: FAIL")

            End If


            ' ------------------------------------------------
            ' RECURSE INTO SUBASSEMBLY
            ' ------------------------------------------------

            ScanOccurrences( _
                SubAssemblyDoc.ComponentDefinition.Occurrences, _
                TotalOccurrences, _
                TotalParts, _
                SheetMetalParts, _
                PLComponents, _
                EligiblePlates, _
                InvalidNames, _
                SubAssemblies)


            Continue For

        End If


        ' ====================================================
        ' PART
        ' ====================================================

        TotalParts += 1


        Dim PartDoc As PartDocument =
            CType(Occurrence.Definition.Document, PartDocument)


        Dim PartName As String =
            Path.GetFileNameWithoutExtension( _
                PartDoc.FullFileName)


        Logger.Section("PART")

        Logger.Info("Occurrence: " & Occurrence.Name)
        Logger.Info("Filename: " & PartName)


        ' ====================================================
        ' PARSE PART NAME
        ' ====================================================

        Dim PartData As PartNameData =
            ParsePartName(PartName)


        If Not PartData.IsValid Then

            InvalidNames += 1

            Logger.Warning( _
                "Part naming convention: FAIL")

            Logger.Warning( _
                "Unable to determine component type.")

            Continue For

        End If


        Logger.Success("Part naming convention: PASS")


        Logger.Debug( _
            "Project: " & PartData.ProjectNumber)

        Logger.Debug( _
            "Project ID: " & PartData.ProjectIdentifier)

        Logger.Debug( _
            "Component type: " & PartData.ComponentType)

        Logger.Debug( _
            "Component number: " & PartData.ComponentNumber)

        Logger.Debug( _
            "Revision: " & PartData.Revision)


        ' ====================================================
        ' CHECK COMPONENT TYPE
        ' ====================================================

        If PartData.ComponentType <> PlateComponentType Then

            Logger.Info( _
                "Component type is not " & PlateComponentType & _
                " - ignored.")

            Continue For

        End If


        PLComponents += 1


        Logger.Info( _
            "Component identified as PL plate.")


        ' ====================================================
        ' CHECK SHEET METAL
        ' ====================================================

        Dim IsSheetMetal As Boolean = IsSheetMetalPart(PartDoc)


        If IsSheetMetal Then

            SheetMetalParts += 1

            Logger.Success("Sheet metal check: PASS")

        Else

            Logger.Warning("Sheet metal check: FAIL")

            Logger.Warning( _
                "PL component is not recognised as sheet metal.")

            Continue For

        End If


        ' ====================================================
        ' SHEET METAL INFORMATION
        ' ====================================================

        Try

            Dim SheetMetalDef As SheetMetalComponentDefinition =
                CType(PartDoc.ComponentDefinition, _
                      SheetMetalComponentDefinition)


            Dim ThicknessMM As Double =
                SheetMetalDef.Thickness * 10


            Logger.Info( _
                "Thickness: " & _
                Math.Round(ThicknessMM, 3) & " mm")


        Catch ex As Exception

            Logger.Warning( _
                "Could not read sheet metal thickness.")

            Logger.Debug(ex.Message)

        End Try


        ' ====================================================
        ' PLATE IS CURRENTLY ELIGIBLE
        ' ====================================================

        EligiblePlates += 1


        Logger.Success( _
            "PLATE ELIGIBILITY: PASS")


        ' ====================================================
        ' FUTURE:
        '
        ' Geometry detection will go here.
        '
        ' Example:
        '
        ' DetectPlateEdges()
        ' DetectCorners()
        ' FindCandidateNibLocations()
        '
        ' ====================================================


    Next

End Sub


' ============================================================
' SHEET METAL CHECK
' ============================================================

Function IsSheetMetalPart(PartDoc As PartDocument) As Boolean

    Try

        Dim Definition As ComponentDefinition =
            PartDoc.ComponentDefinition


        If TypeOf Definition Is SheetMetalComponentDefinition Then

            Return True

        End If


    Catch ex As Exception

        Logger.Debug( _
            "Sheet metal check failed: " & ex.Message)

    End Try


    Return False

End Function


' ============================================================
' PART NAME DATA
' ============================================================

Class PartNameData

    Public IsValid As Boolean = False

    Public ProjectNumber As String
    Public ProjectIdentifier As String
    Public ComponentType As String
    Public ComponentNumber As String
    Public Revision As String

End Class


' ============================================================
' PARSE PART NAME
'
' XXXX-CCC-VVBB-NN
'
' Example:
'
' 9187-DCS-PL07-03
'
' ============================================================

Function ParsePartName(Name As String) As PartNameData

    Dim Result As New PartNameData


    Dim Pattern As String =
        "^([0-9]{4})-([A-Za-z]{3})-([A-Za-z]{2})([0-9]{2})-([0-9]{2})$"


    Dim Match As Match =
        Regex.Match(Name, Pattern)


    If Not Match.Success Then

        Return Result

    End If


    Result.IsValid = True

    Result.ProjectNumber = Match.Groups(1).Value
    Result.ProjectIdentifier = Match.Groups(2).Value
    Result.ComponentType = Match.Groups(3).Value.ToUpper()
    Result.ComponentNumber = Match.Groups(4).Value
    Result.Revision = Match.Groups(5).Value


    Return Result

End Function


' ============================================================
' ASSEMBLY NAME DATA
' ============================================================

Class AssemblyNameData

    Public IsValid As Boolean = False

    Public ProjectNumber As String
    Public Description As String
    Public AssemblyType As String
    Public AssemblyNumber As String
    Public Revision As String

End Class


' ============================================================
' PARSE ASSEMBLY NAME
'
' XXXX-DESCRIPTION-TTNN-VV
'
' Examples:
'
' 9187-DitchCrossingSlab-GA01-01
' 9187-InternalStructure-SA01-01
'
' ============================================================

Function ParseAssemblyName(Name As String) As AssemblyNameData

    Dim Result As New AssemblyNameData


    Dim Pattern As String =
        "^([0-9]{4})-(.+)-([A-Za-z]{2})([0-9]{2})-([0-9]{2})$"


    Dim Match As Match =
        Regex.Match(Name, Pattern)


    If Not Match.Success Then

        Return Result

    End If


    Result.IsValid = True

    Result.ProjectNumber = Match.Groups(1).Value
    Result.Description = Match.Groups(2).Value
    Result.AssemblyType = Match.Groups(3).Value.ToUpper()
    Result.AssemblyNumber = Match.Groups(4).Value
    Result.Revision = Match.Groups(5).Value


    Return Result

End Function


' ============================================================
' DISPLAY LOG
' ============================================================

Sub ShowLog()

    Dim LogText As String = Logger.GetText()


    ' --------------------------------------------------------
    ' MessageBox is convenient during development.
    '
    ' Later we can replace this with:
    '
    ' - an iLogic form
    ' - a dockable Inventor window
    ' - external log file
    ' - dedicated automation UI
    '
    ' --------------------------------------------------------

    MsgBox(LogText, _
           MsgBoxStyle.Information, _
           "Inventor Nib Automation Log")


End Sub


' ============================================================
' RUN
' ============================================================

Main()
