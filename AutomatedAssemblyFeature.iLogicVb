'===========================================================
' iLogic - Assembly Plate Scanner
'
' READ ONLY
'
' Naming convention:
'
'     XXXX-CCC-VVBB-NN
'
'     XXXX = Project number       (4 numbers)
'     CCC  = Project identifier   (3 letters)
'     VV   = Component type       (2 letters)
'     BB   = Component number     (2 numbers)
'     NN   = Revision              (2 numbers)
'
' Example:
'
'     1234-ABC-PL07-03
'
'     Project:       1234
'     Identifier:    ABC
'     Component:     PL
'     Number:        07
'     Revision:      03
'
'===========================================================

Imports System.IO
Imports System.Text.RegularExpressions
Imports Inventor

Sub Main()

    '=======================================================
    ' SETTINGS
    '=======================================================

    'Component type used for metal plates
    Dim PlateComponentType As String = "PL"


    '=======================================================
    ' CHECK ACTIVE DOCUMENT
    '=======================================================

    If ThisApplication.ActiveDocument Is Nothing Then

        MessageBox.Show( _
            "No active document found.", _
            "Assembly Plate Scanner")

        Exit Sub

    End If


    If ThisApplication.ActiveDocument.DocumentType <> _
        DocumentTypeEnum.kAssemblyDocumentObject Then

        MessageBox.Show( _
            "The active document is not an assembly.", _
            "Assembly Plate Scanner")

        Exit Sub

    End If


    Dim asmDoc As AssemblyDocument

    asmDoc = ThisApplication.ActiveDocument


    '=======================================================
    ' START REPORT
    '=======================================================

    Dim report As String = ""

    report = report & _
        "====================================================" & vbCrLf

    report = report & _
        "ASSEMBLY PLATE SCANNER" & vbCrLf

    report = report & _
        "====================================================" & vbCrLf & vbCrLf

    report = report & _
        "Assembly: " & asmDoc.DisplayName & vbCrLf

    report = report & _
        "Date: " & DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss") & vbCrLf

    report = report & vbCrLf


    '=======================================================
    ' COUNTERS
    '=======================================================

    Dim TotalComponents As Integer = 0
    Dim TotalParts As Integer = 0
    Dim TotalSheetMetal As Integer = 0
    Dim TotalPLParts As Integer = 0
    Dim TotalEligible As Integer = 0
    Dim TotalInvalidNames As Integer = 0


    '=======================================================
    ' SCAN ASSEMBLY
    '=======================================================

    Dim occurrences As ComponentOccurrences

    occurrences = asmDoc.ComponentDefinition.Occurrences


    For Each occurrence As ComponentOccurrence In occurrences

        ScanOccurrence( _
            occurrence, _
            0, _
            report, _
            TotalComponents, _
            TotalParts, _
            TotalSheetMetal, _
            TotalPLParts, _
            TotalEligible, _
            TotalInvalidNames, _
            PlateComponentType)

    Next


    '=======================================================
    ' SUMMARY
    '=======================================================

    report = report & vbCrLf

    report = report & _
        "====================================================" & vbCrLf

    report = report & _
        "SUMMARY" & vbCrLf

    report = report & _
        "====================================================" & vbCrLf

    report = report & _
        "Total components:       " & TotalComponents & vbCrLf

    report = report & _
        "Total parts:            " & TotalParts & vbCrLf

    report = report & _
        "Sheet metal parts:      " & TotalSheetMetal & vbCrLf

    report = report & _
        "PL components:          " & TotalPLParts & vbCrLf

    report = report & _
        "Eligible plates:        " & TotalEligible & vbCrLf

    report = report & _
        "Invalid filenames:      " & TotalInvalidNames & vbCrLf


    '=======================================================
    ' DISPLAY
    '=======================================================

    MessageBox.Show( _
        report, _
        "Assembly Plate Scanner")

End Sub


'===========================================================
' RECURSIVE OCCURRENCE SCANNER
'===========================================================

Sub ScanOccurrence( _
    occurrence As ComponentOccurrence, _
    level As Integer, _
    ByRef report As String, _
    ByRef TotalComponents As Integer, _
    ByRef TotalParts As Integer, _
    ByRef TotalSheetMetal As Integer, _
    ByRef TotalPLParts As Integer, _
    ByRef TotalEligible As Integer, _
    ByRef TotalInvalidNames As Integer, _
    PlateComponentType As String)


    TotalComponents = TotalComponents + 1


    '-------------------------------------------------------
    ' Indentation
    '-------------------------------------------------------

    Dim indent As String = ""

    For i As Integer = 1 To level

        indent = indent & "    "

    Next


    '-------------------------------------------------------
    ' Get filename
    '-------------------------------------------------------

    Dim fileName As String = ""
    Dim fullPath As String = ""

    Try

        fullPath = occurrence.Definition.Document.FullFileName

        If fullPath <> "" Then

            fileName = Path.GetFileName(fullPath)

        End If

    Catch

        fileName = "(unresolved)"

    End Try


    '=======================================================
    ' ASSEMBLY
    '=======================================================

    If occurrence.DefinitionDocumentType = _
        DocumentTypeEnum.kAssemblyDocumentObject Then


        report = report & _
            indent & "┌─ ASSEMBLY" & vbCrLf

        report = report & _
            indent & "│  " & occurrence.Name & vbCrLf

        report = report & _
            indent & "│  File: " & fileName & vbCrLf


        Try

            Dim children As ComponentOccurrences

            children = occurrence.SubOccurrences


            For Each child As ComponentOccurrence _
                In children

                ScanOccurrence( _
                    child, _
                    level + 1, _
                    report, _
                    TotalComponents, _
                    TotalParts, _
                    TotalSheetMetal, _
                    TotalPLParts, _
                    TotalEligible, _
                    TotalInvalidNames, _
                    PlateComponentType)

            Next


        Catch

            report = report & _
                indent & "│  ERROR: Unable to scan subassembly" & vbCrLf

        End Try


        report = report & vbCrLf

        Exit Sub

    End If


    '=======================================================
    ' ONLY PROCESS PARTS
    '=======================================================

    If occurrence.DefinitionDocumentType <> _
        DocumentTypeEnum.kPartDocumentObject Then

        Exit Sub

    End If


    TotalParts = TotalParts + 1


    Dim partDoc As PartDocument

    Try

        partDoc = occurrence.Definition.Document

    Catch

        report = report & _
            indent & "┌─ PART - UNRESOLVED" & vbCrLf

        report = report & _
            indent & "│  " & occurrence.Name & vbCrLf

        report = report & vbCrLf

        Exit Sub

    End Try


    '=======================================================
    ' CHECK SHEET METAL
    '=======================================================

    Dim IsSheetMetal As Boolean = False


    Try

        If partDoc.SubType = _
            "{9C6D8F8E-1A4E-11D3-BE70-0060B0E6D4F5}" Then

            IsSheetMetal = True

        End If

    Catch

        IsSheetMetal = False

    End Try


    If IsSheetMetal Then

        TotalSheetMetal = TotalSheetMetal + 1

    End If


    '=======================================================
    ' GET FILENAME WITHOUT EXTENSION
    '=======================================================

    Dim baseFileName As String = ""

    If fileName <> "(unresolved)" Then

        baseFileName = _
            Path.GetFileNameWithoutExtension(fileName)

    End If


    '=======================================================
    ' PARSE NAMING CONVENTION
    '=======================================================

    Dim NamingValid As Boolean = False

    Dim ProjectNumber As String = ""
    Dim ProjectIdentifier As String = ""
    Dim ComponentType As String = ""
    Dim ComponentNumber As String = ""
    Dim Revision As String = ""


    'Expected:
    '
    'XXXX-CCC-VVBB-NN
    '
    'Example:
    '
    '1234-ABC-PL07-03

    Dim pattern As String = _
        "^([0-9]{4})-([A-Za-z]{3})-([A-Za-z]{2})([0-9]{2})-([0-9]{2})$"


    Dim match As Match = _
        Regex.Match(baseFileName, pattern)


    If match.Success Then

        NamingValid = True

        ProjectNumber = match.Groups(1).Value

        ProjectIdentifier = _
            match.Groups(2).Value.ToUpper()

        ComponentType = _
            match.Groups(3).Value.ToUpper()

        ComponentNumber = match.Groups(4).Value

        Revision = match.Groups(5).Value

    End If


    '=======================================================
    ' DETERMINE WHETHER THIS IS A PLATE
    '=======================================================

    Dim IsPL As Boolean = False


    If NamingValid Then

        If ComponentType = _
            PlateComponentType.ToUpper() Then

            IsPL = True

        End If

    End If


    If IsPL Then

        TotalPLParts = TotalPLParts + 1

    End If


    '=======================================================
    ' ONLY SHOW INTERESTING PARTS
    '
    ' For now:
    '
    '   - All PL parts
    '   - All sheet metal parts with invalid names
    '
    ' This lets us identify naming problems.
    '=======================================================

    If Not IsPL And NamingValid Then

        Exit Sub

    End If


    '=======================================================
    ' GET iPROPERTIES
    '=======================================================

    Dim PartNumber As String = ""
    Dim Description As String = ""
    Dim Material As String = ""


    Try

        PartNumber = _
            partDoc.PropertySets( _
                "Design Tracking Properties"). _
                Item("Part Number").Value.ToString()

    Catch

        PartNumber = "(not set)"

    End Try


    Try

        Description = _
            partDoc.PropertySets( _
                "Design Tracking Properties"). _
                Item("Description").Value.ToString()

    Catch

        Description = "(not set)"

    End Try


    Try

        Material = _
            partDoc.PropertySets( _
                "Design Tracking Properties"). _
                Item("Material").Value.ToString()

    Catch

        Material = "(not set)"

    End Try


    '=======================================================
    ' SHEET METAL THICKNESS
    '=======================================================

    Dim Thickness As String = "(unknown)"


    If IsSheetMetal Then

        Try

            Dim smDef As SheetMetalComponentDefinition

            smDef = partDoc.ComponentDefinition


            Dim thicknessValue As Double

            thicknessValue = smDef.Thickness.Value


            'Inventor internal length units = cm
            'Convert to mm

            Dim thicknessMM As Double

            thicknessMM = thicknessValue * 10


            Thickness = _
                thicknessMM.ToString("0.00") & " mm"


        Catch

            Thickness = "(unknown)"

        End Try

    End If


    '=======================================================
    ' DETERMINE ELIGIBILITY
    '=======================================================

    Dim Eligible As Boolean = True

    Dim Reason As String = ""


    If Not NamingValid Then

        Eligible = False

        Reason = _
            "Filename does not match XXXX-CCC-VVBB-NN."

        TotalInvalidNames = _
            TotalInvalidNames + 1

    ElseIf Not IsPL Then

        Eligible = False

        Reason = _
            "Component type is " & _
            ComponentType & _
            ", not PL."

    ElseIf Not IsSheetMetal Then

        Eligible = False

        Reason = _
            "Filename identifies a PL component, " & _
            "but Inventor does not identify it as sheet metal."

    End If


    If Eligible Then

        TotalEligible = TotalEligible + 1

    End If


    '=======================================================
    ' WRITE RECORD
    '=======================================================

    report = report & vbCrLf

    report = report & _
        indent & "╔════════════════════════════════════════════════" & vbCrLf

    report = report & _
        indent & "║ PLATE CANDIDATE" & vbCrLf

    report = report & _
        indent & "╠════════════════════════════════════════════════" & vbCrLf


    report = report & _
        indent & "║ Occurrence:       " & _
        occurrence.Name & vbCrLf

    report = report & _
        indent & "║ File:             " & _
        fileName & vbCrLf

    report = report & _
        indent & "║ Path:             " & _
        fullPath & vbCrLf


    report = report & _
        indent & "║" & vbCrLf


    '-------------------------------------------------------
    ' Naming information
    '-------------------------------------------------------

    report = report & _
        indent & "║ NAMING" & vbCrLf


    report = report & _
        indent & "║   Valid:          " & _
        IfText(NamingValid, "YES", "NO") & vbCrLf


    If NamingValid Then

        report = report & _
            indent & "║   Project:        " & _
            ProjectNumber & vbCrLf

        report = report & _
            indent & "║   Identifier:     " & _
            ProjectIdentifier & vbCrLf

        report = report & _
            indent & "║   Component Type:  " & _
            ComponentType & vbCrLf

        report = report & _
            indent & "║   Component No:   " & _
            ComponentNumber & vbCrLf

        report = report & _
            indent & "║   Revision:       " & _
            Revision & vbCrLf

    End If


    report = report & _
        indent & "║" & vbCrLf


    '-------------------------------------------------------
    ' Inventor information
    '-------------------------------------------------------

    report = report & _
        indent & "║ INVENTOR" & vbCrLf

    report = report & _
        indent & "║   Sheet Metal:    " & _
        IfText(IsSheetMetal, "YES", "NO") & vbCrLf

    report = report & _
        indent & "║   Thickness:      " & _
        Thickness & vbCrLf

    report = report & _
        indent & "║   Part Number:    " & _
        PartNumber & vbCrLf

    report = report & _
        indent & "║   Description:    " & _
        Description & vbCrLf

    report = report & _
        indent & "║   Material:       " & _
        Material & vbCrLf


    report = report & _
        indent & "║" & vbCrLf


    '-------------------------------------------------------
    ' Result
    '-------------------------------------------------------

    If Eligible Then

        report = report & _
            indent & "║ RESULT:           ELIGIBLE FOR NIB PROCESSING" & vbCrLf

    Else

        report = report & _
            indent & "║ RESULT:           NOT ELIGIBLE" & vbCrLf

        report = report & _
            indent & "║ REASON:           " & _
            Reason & vbCrLf

    End If


    report = report & _
        indent & "╚════════════════════════════════════════════════" & vbCrLf


End Sub


'===========================================================
' SIMPLE TRUE/FALSE TEXT FUNCTION
'===========================================================

Function IfText( _
    condition As Boolean, _
    trueText As String, _
    falseText As String) As String

    If condition Then

        Return trueText

    Else

        Return falseText

    End If

End Function
