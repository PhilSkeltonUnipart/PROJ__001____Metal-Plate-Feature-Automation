' ============================================================
' INVENTOR NIB AUTOMATION
'
' Assembly / Plate Scanner
'
' Version: 0.2
'
' Purpose:
'   - Scan the active Inventor assembly
'   - Recursively scan subassemblies
'   - Validate assembly naming
'   - Validate part naming
'   - Identify PL components
'   - Identify sheet metal parts
'   - Read sheet metal thickness
'   - Measure physical geometry thickness
'   - Produce a centralised diagnostic log
'
' ============================================================


' ============================================================
' MAIN
' ============================================================

Sub Main()

    ' --------------------------------------------------------
    ' SETTINGS
    ' --------------------------------------------------------

    Dim PlateComponentType As String = "PL"

    Dim DebugLogging As Boolean = True

    ' Difference between the Inventor sheet-metal parameter
    ' and the measured geometry which will generate a warning.

    Dim ThicknessWarningToleranceMM As Double = 0.1


    ' --------------------------------------------------------
    ' START LOGGER
    ' --------------------------------------------------------

    Logger.Start()

    Logger.Section("STARTING ASSEMBLY SCAN")


    Try

        ' ----------------------------------------------------
        ' INVENTOR INFORMATION
        ' ----------------------------------------------------

        Logger.Info( _
            "Inventor version: " & _
            ThisApplication.SoftwareVersion.ToString())


        ' ----------------------------------------------------
        ' GET ACTIVE DOCUMENT
        ' ----------------------------------------------------

        Dim ActiveDoc As Inventor.Document = _
            ThisApplication.ActiveDocument


        If ActiveDoc Is Nothing Then

            Logger.Error( _
                "No active document found.")

            ShowLog()

            Exit Sub

        End If


        Logger.Info( _
            "Active document: " & _
            ActiveDoc.DisplayName)


        ' ----------------------------------------------------
        ' CHECK DOCUMENT TYPE
        ' ----------------------------------------------------

        If ActiveDoc.DocumentType <> _
            Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then

            Logger.Error( _
                "Active document is not an assembly.")

            Logger.Info( _
                "Please open an assembly before running the scanner.")

            ShowLog()

            Exit Sub

        End If


        ' ----------------------------------------------------
        ' CONVERT TO ASSEMBLY DOCUMENT
        ' ----------------------------------------------------

        Dim AssemblyDoc As Inventor.AssemblyDocument = _
            CType( _
                ActiveDoc, _
                Inventor.AssemblyDocument)


        ' ----------------------------------------------------
        ' ASSEMBLY INFORMATION
        ' ----------------------------------------------------

        Logger.Section("ASSEMBLY INFORMATION")


        Dim AssemblyName As String = _
            System.IO.Path.GetFileNameWithoutExtension( _
                AssemblyDoc.FullFileName)


        Logger.Info( _
            "Assembly filename: " & _
            AssemblyName)


        Dim AssemblyData As AssemblyNameData = _
            ParseAssemblyName(AssemblyName)


        If AssemblyData.IsValid Then

            Logger.Success( _
                "Assembly naming convention: PASS")


            Logger.Info( _
                "Project: " & _
                AssemblyData.ProjectNumber)


            Logger.Info( _
                "Description: " & _
                AssemblyData.Description)


            Logger.Info( _
                "Assembly type: " & _
                AssemblyData.AssemblyType)


            Logger.Info( _
                "Assembly number: " & _
                AssemblyData.AssemblyNumber)


            Logger.Info( _
                "Revision: " & _
                AssemblyData.Revision)


        Else

            Logger.Warning( _
                "Assembly naming convention: FAIL")

        End If


        ' ----------------------------------------------------
        ' COUNTERS
        ' ----------------------------------------------------

        Dim TotalOccurrences As Integer = 0

        Dim TotalParts As Integer = 0

        Dim SheetMetalParts As Integer = 0

        Dim PLComponents As Integer = 0

        Dim EligiblePlates As Integer = 0

        Dim InvalidNames As Integer = 0

        Dim SubAssemblies As Integer = 0


        ' ----------------------------------------------------
        ' SCAN ASSEMBLY
        ' ----------------------------------------------------

        Logger.Section("SCANNING COMPONENTS")


        ScanOccurrences( _
            AssemblyDoc.ComponentDefinition.Occurrences, _
            PlateComponentType, _
            DebugLogging, _
            ThicknessWarningToleranceMM, _
            TotalOccurrences, _
            TotalParts, _
            SheetMetalParts, _
            PLComponents, _
            EligiblePlates, _
            InvalidNames, _
            SubAssemblies)


        ' ----------------------------------------------------
        ' SUMMARY
        ' ----------------------------------------------------

        Logger.Section("SCAN SUMMARY")


        Logger.Info( _
            "Assemblies found: " & _
            SubAssemblies)


        Logger.Info( _
            "Total occurrences: " & _
            TotalOccurrences)


        Logger.Info( _
            "Total parts: " & _
            TotalParts)


        Logger.Info( _
            "Sheet metal parts: " & _
            SheetMetalParts)


        Logger.Info( _
            "PL components: " & _
            PLComponents)


        Logger.Info( _
            "Eligible plates: " & _
            EligiblePlates)


        Logger.Info( _
            "Invalid filenames: " & _
            InvalidNames)


        ' ----------------------------------------------------
        ' COMPLETE
        ' ----------------------------------------------------

        Logger.Section("SCAN COMPLETE")


        Logger.Success( _
            "Assembly scan completed.")


    Catch ex As Exception

        ' ----------------------------------------------------
        ' UNEXPECTED ERROR
        ' ----------------------------------------------------

        Logger.Error( _
            "UNEXPECTED ERROR")


        Logger.Error( _
            ex.Message)


        Logger.Debug( _
            ex.StackTrace)


    End Try


    ' --------------------------------------------------------
    ' SHOW LOG
    ' --------------------------------------------------------

    ShowLog()


End Sub


' ============================================================
' RECURSIVE ASSEMBLY SCANNER
' ============================================================

Sub ScanOccurrences( _
    Occurrences As Inventor.ComponentOccurrences, _
    PlateComponentType As String, _
    DebugLogging As Boolean, _
    ThicknessWarningToleranceMM As Double, _
    ByRef TotalOccurrences As Integer, _
    ByRef TotalParts As Integer, _
    ByRef SheetMetalParts As Integer, _
    ByRef PLComponents As Integer, _
    ByRef EligiblePlates As Integer, _
    ByRef InvalidNames As Integer, _
    ByRef SubAssemblies As Integer)


    ' --------------------------------------------------------
    ' LOOP THROUGH OCCURRENCES
    ' --------------------------------------------------------

    For Each Occurrence As Inventor.ComponentOccurrence _
        In Occurrences


        TotalOccurrences += 1


        Logger.Debug( _
            "Inspecting occurrence: " & _
            Occurrence.Name)


        ' ====================================================
        ' SUPPRESSED COMPONENT
        ' ====================================================

        If Occurrence.Suppressed Then

            Logger.Warning( _
                Occurrence.Name & _
                " is suppressed - skipped.")

            Continue For

        End If


        ' ====================================================
        ' CHECK FOR SUBASSEMBLY
        ' ====================================================

        If Occurrence.DefinitionDocumentType = _
            Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then


            SubAssemblies += 1


            Dim SubAssemblyDoc As Inventor.AssemblyDocument = _
                CType( _
                    Occurrence.Definition.Document, _
                    Inventor.AssemblyDocument)


            Dim SubAssemblyName As String = _
                System.IO.Path.GetFileNameWithoutExtension( _
                    SubAssemblyDoc.FullFileName)


            Logger.Section("SUBASSEMBLY")


            Logger.Info( _
                "Name: " & _
                SubAssemblyName)


            ' ------------------------------------------------
            ' PARSE SUBASSEMBLY NAME
            ' ------------------------------------------------

            Dim SubAssemblyData As AssemblyNameData = _
                ParseAssemblyName(SubAssemblyName)


            If SubAssemblyData.IsValid Then

                Logger.Success( _
                    "Naming convention: PASS")


                Logger.Debug( _
                    "Project: " & _
                    SubAssemblyData.ProjectNumber)


                Logger.Debug( _
                    "Description: " & _
                    SubAssemblyData.Description)


                Logger.Debug( _
                    "Type: " & _
                    SubAssemblyData.AssemblyType)


                Logger.Debug( _
                    "Number: " & _
                    SubAssemblyData.AssemblyNumber)


                Logger.Debug( _
                    "Revision: " & _
                    SubAssemblyData.Revision)


            Else

                Logger.Warning( _
                    "Subassembly naming convention: FAIL")

            End If


            ' ------------------------------------------------
            ' RECURSE INTO SUBASSEMBLY
            ' ------------------------------------------------

            ScanOccurrences( _
                SubAssemblyDoc.ComponentDefinition.Occurrences, _
                PlateComponentType, _
                DebugLogging, _
                ThicknessWarningToleranceMM, _
                TotalOccurrences, _
                TotalParts, _
                SheetMetalParts, _
                PLComponents, _
                EligiblePlates, _
                InvalidNames, _
                SubAssemblies)


            Continue For


        End If


        ' ====================================================
        ' PART
        ' ====================================================

        TotalParts += 1


        Dim PartDoc As Inventor.PartDocument = _
            CType( _
                Occurrence.Definition.Document, _
                Inventor.PartDocument)


        Dim PartName As String = _
            System.IO.Path.GetFileNameWithoutExtension( _
                PartDoc.FullFileName)


        Logger.Section("PART")


        Logger.Info( _
            "Occurrence: " & _
            Occurrence.Name)


        Logger.Info( _
            "Filename: " & _
            PartName)


        ' ====================================================
        ' PARSE PART NAME
        ' ====================================================

        Dim PartData As PartNameData = _
            ParsePartName(PartName)


        If Not PartData.IsValid Then

            InvalidNames += 1


            Logger.Warning( _
                "Part naming convention: FAIL")


            Logger.Warning( _
                "Unable to determine component type.")


            Continue For

        End If


        Logger.Success( _
            "Part naming convention: PASS")


        Logger.Debug( _
            "Project: " & _
            PartData.ProjectNumber)


        Logger.Debug( _
            "Project ID: " & _
            PartData.ProjectIdentifier)


        Logger.Debug( _
            "Component type: " & _
            PartData.ComponentType)


        Logger.Debug( _
            "Component number: " & _
            PartData.ComponentNumber)


        Logger.Debug( _
            "Revision: " & _
            PartData.Revision)


        ' ====================================================
        ' CHECK COMPONENT TYPE
        ' ====================================================

        If PartData.ComponentType <> _
            PlateComponentType Then


            Logger.Info( _
                "Component type is not " & _
                PlateComponentType & _
                " - ignored.")


            Continue For

        End If


        PLComponents += 1


        Logger.Info( _
            "Component identified as PL plate.")


        ' ====================================================
        ' CHECK SHEET METAL
        ' ====================================================

        Dim IsSheetMetal As Boolean = _
            IsSheetMetalPart(PartDoc)


        If IsSheetMetal Then

            SheetMetalParts += 1


            Logger.Success( _
                "Sheet metal check: PASS")


        Else

            Logger.Warning( _
                "Sheet metal check: FAIL")


            Logger.Warning( _
                "PL component is not recognised as sheet metal.")


            Continue For

        End If


        ' ====================================================
        ' PHYSICAL PLATE THICKNESS
        ' ====================================================

        Logger.Section("PLATE THICKNESS ANALYSIS")


        Dim ParameterThicknessMM As Double = 0

        Dim GeometricThicknessMM As Double = 0

        Dim PhysicalThicknessMM As Double = 0

        Dim ThicknessSource As String = ""


        PhysicalThicknessMM = _
            GetPhysicalPlateThicknessMM( _
                PartDoc, _
                ParameterThicknessMM, _
                GeometricThicknessMM, _
                ThicknessSource)


        ' ----------------------------------------------------
        ' REPORT SHEET METAL PARAMETER
        ' ----------------------------------------------------

        If ParameterThicknessMM > 0 Then

            Logger.Info( _
                "Sheet-metal parameter thickness: " & _
                Math.Round( _
                    ParameterThicknessMM, _
                    3) & _
                " mm")

        Else

            Logger.Warning( _
                "Sheet-metal parameter thickness unavailable.")

        End If


        ' ----------------------------------------------------
        ' REPORT GEOMETRIC THICKNESS
        ' ----------------------------------------------------

        If GeometricThicknessMM > 0 Then

            Logger.Info( _
                "Measured geometric thickness: " & _
                Math.Round( _
                    GeometricThicknessMM, _
                    3) & _
                " mm")

        Else

            Logger.Warning( _
                "Geometric thickness could not be measured.")

        End If


        ' ----------------------------------------------------
        ' REPORT SELECTED THICKNESS
        ' ----------------------------------------------------

        If PhysicalThicknessMM > 0 Then

            Logger.Success( _
                "Thickness used by automation: " & _
                Math.Round( _
                    PhysicalThicknessMM, _
                    3) & _
                " mm")


            Logger.Debug( _
                "Thickness source: " & _
                ThicknessSource)

        Else

            Logger.Error( _
                "Unable to determine physical plate thickness.")

        End If


        ' ----------------------------------------------------
        ' CHECK FOR DISCREPANCY
        ' ----------------------------------------------------

        If ParameterThicknessMM > 0 And _
           GeometricThicknessMM > 0 Then


            Dim ThicknessDifference As Double = _
                Math.Abs( _
                    ParameterThicknessMM - _
                    GeometricThicknessMM)


            If ThicknessDifference > _
                ThicknessWarningToleranceMM Then


                Logger.Warning( _
                    "THICKNESS DISCREPANCY DETECTED")


                Logger.Warning( _
                    "Sheet-metal parameter = " & _
                    Math.Round( _
                        ParameterThicknessMM, _
                        3) & _
                    " mm")


                Logger.Warning( _
                    "Physical geometry = " & _
                    Math.Round( _
                        GeometricThicknessMM, _
                        3) & _
                    " mm")


                Logger.Warning( _
                    "Difference = " & _
                    Math.Round( _
                        ThicknessDifference, _
                        3) & _
                    " mm")


            Else


                Logger.Success( _
                    "Sheet-metal parameter and geometry agree.")


            End If


        End If


        ' ====================================================
        ' CURRENT PLATE ELIGIBILITY
        ' ====================================================

        EligiblePlates += 1


        Logger.Success( _
            "PLATE ELIGIBILITY: PASS")


        ' ====================================================
        ' FUTURE GEOMETRY PROCESSING
        ' ====================================================
        '
        ' DetectPlateEdges()
        '
        ' DetectCorners()
        '
        ' FindCandidateNibLocations()
        '
        ' SelectNib()
        '
        ' InsertNib()
        '
        ' ====================================================


    Next


End Sub


' ============================================================
' SHEET METAL CHECK
' ============================================================

Function IsSheetMetalPart( _
    PartDoc As Inventor.PartDocument) As Boolean


    Try


        Dim Definition As Inventor.ComponentDefinition = _
            PartDoc.ComponentDefinition


        If TypeOf Definition Is _
            Inventor.SheetMetalComponentDefinition Then


            Return True


        End If


    Catch ex As Exception


        Logger.Debug( _
            "Sheet metal check failed: " & _
            ex.Message)


    End Try


    Return False


End Function


' ============================================================
' GET PHYSICAL PLATE THICKNESS
'
' This function deliberately does NOT rely solely on the
' SheetMetalComponentDefinition.Thickness parameter.
'
' It obtains:
'
'   1. Sheet-metal parameter thickness
'   2. Actual geometric minimum dimension
'
' The geometric measurement is used as the physical thickness
' for the automation when available.
'
' ============================================================

Function GetPhysicalPlateThicknessMM( _
    PartDoc As Inventor.PartDocument, _
    ByRef ParameterThicknessMM As Double, _
    ByRef GeometricThicknessMM As Double, _
    ByRef ThicknessSource As String) As Double


    ParameterThicknessMM = 0

    GeometricThicknessMM = 0

    ThicknessSource = "Unavailable"


    ' ========================================================
    ' STEP 1
    ' Get Inventor sheet-metal parameter thickness
    ' ========================================================

    Try


        Dim SheetMetalDef As _
            Inventor.SheetMetalComponentDefinition = _
            CType( _
                PartDoc.ComponentDefinition, _
                Inventor.SheetMetalComponentDefinition)


        ' Inventor database length units are cm.

        ParameterThicknessMM = _
            SheetMetalDef.Thickness.Value * 10


        ' ----------------------------------------------------
        ' Report whether thickness comes from the sheet-metal
        ' style or is explicitly overridden.
        ' ----------------------------------------------------

        If SheetMetalDef.UseSheetMetalStyleThickness Then

            Logger.Debug( _
                "Sheet-metal thickness is controlled by active style.")

        Else

            Logger.Debug( _
                "Sheet-metal thickness is explicitly overridden.")

        End If


    Catch ex As Exception


        Logger.Warning( _
            "Could not read sheet-metal parameter thickness.")


        Logger.Debug( _
            ex.Message)


    End Try


    ' ========================================================
    ' STEP 2
    ' Measure actual geometry
    ' ========================================================

    Try


        Dim PartDef As Inventor.PartComponentDefinition = _
            CType( _
                PartDoc.ComponentDefinition, _
                Inventor.PartComponentDefinition)


        ' ----------------------------------------------------
        ' Get oriented minimum range box.
        '
        ' This is independent of the part's orientation in
        ' the assembly.
        ' ----------------------------------------------------

        Dim MinimumBox As Inventor.OrientedBox = _
            PartDef.OrientedMinimumRangeBox


        ' ----------------------------------------------------
        ' Get the three physical bounding dimensions.
        '
        ' Inventor database units = cm.
        ' Convert to mm by multiplying by 10.
        ' ----------------------------------------------------

        Dim DimensionOneMM As Double = _
            MinimumBox.DirectionOne.Length * 10


        Dim DimensionTwoMM As Double = _
            MinimumBox.DirectionTwo.Length * 10


        Dim DimensionThreeMM As Double = _
            MinimumBox.DirectionThree.Length * 10


        Logger.Debug( _
            "Geometric dimension 1: " & _
            Math.Round( _
                DimensionOneMM, _
                3) & _
            " mm")


        Logger.Debug( _
            "Geometric dimension 2: " & _
            Math.Round( _
                DimensionTwoMM, _
                3) & _
            " mm")


        Logger.Debug( _
            "Geometric dimension 3: " & _
            Math.Round( _
                DimensionThreeMM, _
                3) & _
                " mm")


        ' ----------------------------------------------------
        ' Determine the smallest physical dimension.
        '
        ' For a normal flat plate this is the plate thickness.
        ' ----------------------------------------------------

        GeometricThicknessMM = _
            Math.Min( _
                DimensionOneMM, _
                Math.Min( _
                    DimensionTwoMM, _
                    DimensionThreeMM))


        Logger.Debug( _
            "Smallest geometric dimension: " & _
            Math.Round( _
                GeometricThicknessMM, _
                3) & _
            " mm")


    Catch ex As Exception


        Logger.Warning( _
            "Could not measure geometric plate thickness.")


        Logger.Debug( _
            ex.Message)


    End Try


    ' ========================================================
    ' STEP 3
    ' Select physical thickness
    ' ========================================================

    If GeometricThicknessMM > 0 Then


        PhysicalThicknessMM = _
            GeometricThicknessMM


        ThicknessSource = _
            "Measured plate geometry"


    ElseIf ParameterThicknessMM > 0 Then


        PhysicalThicknessMM = _
            ParameterThicknessMM


        ThicknessSource = _
            "Sheet-metal parameter (fallback)"


    Else


        PhysicalThicknessMM = 0

        ThicknessSource = _
            "No thickness available"


    End If


    Return PhysicalThicknessMM


End Function


' ============================================================
' PART NAME DATA
' ============================================================

Class PartNameData

    Public IsValid As Boolean = False

    Public ProjectNumber As String

    Public ProjectIdentifier As String

    Public ComponentType As String

    Public ComponentNumber As String

    Public Revision As String

End Class


' ============================================================
' PARSE PART NAME
'
' Format:
'
' XXXX-CCC-VVBB-NN
'
' Example:
'
' 9187-DCS-PL07-03
'
' ============================================================

Function ParsePartName( _
    Name As String) As PartNameData


    Dim Result As New PartNameData


    Dim Pattern As String = _
        "^([0-9]{4})-([A-Za-z]{3})-([A-Za-z]{2})([0-9]{2})-([0-9]{2})$"


    Dim Match As _
        System.Text.RegularExpressions.Match = _
        System.Text.RegularExpressions.Regex.Match( _
            Name, _
            Pattern)


    If Not Match.Success Then

        Return Result

    End If


    Result.IsValid = True


    Result.ProjectNumber = _
        Match.Groups(1).Value


    Result.ProjectIdentifier = _
        Match.Groups(2).Value


    Result.ComponentType = _
        Match.Groups(3).Value.ToUpper()


    Result.ComponentNumber = _
        Match.Groups(4).Value


    Result.Revision = _
        Match.Groups(5).Value


    Return Result


End Function


' ============================================================
' ASSEMBLY NAME DATA
' ============================================================

Class AssemblyNameData

    Public IsValid As Boolean = False

    Public ProjectNumber As String

    Public Description As String

    Public AssemblyType As String

    Public AssemblyNumber As String

    Public Revision As String

End Class


' ============================================================
' PARSE ASSEMBLY NAME
'
' Format:
'
' XXXX-DESCRIPTION-TTNN-VV
'
' Examples:
'
' 9187-DitchCrossingSlab-GA01-01
'
' 9187-InternalStructure-SA01-01
'
' ============================================================

Function ParseAssemblyName( _
    Name As String) As AssemblyNameData


    Dim Result As New AssemblyNameData


    Dim Pattern As String = _
        "^([0-9]{4})-(.+)-([A-Za-z]{2})([0-9]{2})-([0-9]{2})$"


    Dim Match As _
        System.Text.RegularExpressions.Match = _
        System.Text.RegularExpressions.Regex.Match( _
            Name, _
            Pattern)


    If Not Match.Success Then

        Return Result

    End If


    Result.IsValid = True


    Result.ProjectNumber = _
        Match.Groups(1).Value


    Result.Description = _
        Match.Groups(2).Value


    Result.AssemblyType = _
        Match.Groups(3).Value.ToUpper()


    Result.AssemblyNumber = _
        Match.Groups(4).Value


    Result.Revision = _
        Match.Groups(5).Value


    Return Result


End Function


' ============================================================
' DISPLAY LOG
'
' Scrollable log window.
'
' ============================================================

Sub ShowLog()


    Dim LogText As String = _
        Logger.GetText()


    Dim LogForm As New System.Windows.Forms.Form


    LogForm.Text = _
        "Inventor Nib Automation Log"


    LogForm.StartPosition = _
        System.Windows.Forms.FormStartPosition.CenterScreen


    LogForm.Width = 1000

    LogForm.Height = 700


    LogForm.MaximizeBox = True

    LogForm.MinimizeBox = True


    Dim LogBox As New System.Windows.Forms.TextBox


    LogBox.Multiline = True

    LogBox.ReadOnly = True


    LogBox.ScrollBars = _
        System.Windows.Forms.ScrollBars.Both


    LogBox.WordWrap = False


    LogBox.Dock = _
        System.Windows.Forms.DockStyle.Fill


    LogBox.Text = LogText


    Dim CloseButton As _
        New System.Windows.Forms.Button


    CloseButton.Text = "Close"


    CloseButton.Width = 100

    CloseButton.Height = 30


    CloseButton.Dock = _
        System.Windows.Forms.DockStyle.Bottom


    CloseButton.DialogResult = _
        System.Windows.Forms.DialogResult.OK


    LogForm.Controls.Add(LogBox)

    LogForm.Controls.Add(CloseButton)


    LogForm.AcceptButton = CloseButton

    LogForm.CancelButton = CloseButton


    LogForm.ShowDialog()


End Sub


' ============================================================
' LOGGER
' ============================================================

Class Logger


    Private Shared LogLines As _
        New System.Collections.Generic.List(Of String)


    ' --------------------------------------------------------
    ' START
    ' --------------------------------------------------------

    Public Shared Sub Start()


        LogLines.Clear()


        WriteLine( _
            "============================================================")


        WriteLine( _
            "INVENTOR NIB AUTOMATION LOG")


        WriteLine( _
            "Started: " & _
            DateTime.Now.ToString( _
                "yyyy-MM-dd HH:mm:ss"))


        WriteLine( _
            "============================================================")


    End Sub


    ' --------------------------------------------------------
    ' INFO
    ' --------------------------------------------------------

    Public Shared Sub Info( _
        Message As String)


        WriteLine( _
            "[INFO]    " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' SUCCESS
    ' --------------------------------------------------------

    Public Shared Sub Success( _
        Message As String)


        WriteLine( _
            "[SUCCESS] " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' WARNING
    ' --------------------------------------------------------

    Public Shared Sub Warning( _
        Message As String)


        WriteLine( _
            "[WARNING] " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' ERROR
    ' --------------------------------------------------------

    Public Shared Sub [Error]( _
        Message As String)


        WriteLine( _
            "[ERROR]   " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' DEBUG
    ' --------------------------------------------------------

    Public Shared Sub Debug( _
        Message As String)


        WriteLine( _
            "[DEBUG]   " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' SECTION
    ' --------------------------------------------------------

    Public Shared Sub Section( _
        Name As String)


        WriteLine("")


        WriteLine( _
            "------------------------------------------------------------")


        WriteLine( _
            Name)


        WriteLine( _
            "------------------------------------------------------------")


    End Sub


    ' --------------------------------------------------------
    ' INTERNAL WRITE METHOD
    ' --------------------------------------------------------

    Private Shared Sub WriteLine( _
        Message As String)


        Dim TimeStamp As String = _
            DateTime.Now.ToString("HH:mm:ss")


        LogLines.Add( _
            "[" & _
            TimeStamp & _
            "] " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' RETURN COMPLETE LOG
    ' --------------------------------------------------------

    Public Shared Function GetText() As String


        Return String.Join( _
            vbCrLf, _
            LogLines)


    End Function


    ' --------------------------------------------------------
    ' SAVE LOG TO FILE
    ' --------------------------------------------------------

    Public Shared Sub SaveToFile( _
        FilePath As String)


        Try


            System.IO.File.WriteAllText( _
                FilePath, _
                GetText())


        Catch ex As Exception


            MsgBox( _
                "Unable to save log file:" & _
                vbCrLf & _
                ex.Message)


        End Try


    End Sub


End Class
