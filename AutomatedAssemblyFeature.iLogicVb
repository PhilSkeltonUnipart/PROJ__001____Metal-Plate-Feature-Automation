```vbnet
'===========================================================
' iLogic - Assembly Plate Scanner
'
' READ ONLY
'
' Scans the active assembly recursively and creates a
' useful record for every part found.
'
' Nothing in the assembly is modified.
'===========================================================

Imports System.IO
Imports Inventor

Sub Main()

    '=======================================================
    ' SETTINGS
    '=======================================================

    'Change this to match your actual naming convention.
    'For example:
    '   "PLATE_"
    '   "SM_"
    '   "PL"
    '
    'Set to "" if you don't want to use filename checking.

    Dim RequiredFilenamePrefix As String = "PLATE_"


    '=======================================================
    ' CHECK ACTIVE DOCUMENT
    '=======================================================

    If ThisApplication.ActiveDocument Is Nothing Then

        MessageBox.Show( _
            "No active document found.", _
            "Plate Scanner")

        Exit Sub

    End If


    If ThisApplication.ActiveDocument.DocumentType <> _
        DocumentTypeEnum.kAssemblyDocumentObject Then

        MessageBox.Show( _
            "The active document is not an assembly.", _
            "Plate Scanner")

        Exit Sub

    End If


    Dim asmDoc As AssemblyDocument

    asmDoc = ThisApplication.ActiveDocument


    '=======================================================
    ' START REPORT
    '=======================================================

    Dim report As String = ""

    report = report & _
        "====================================================" & vbCrLf

    report = report & _
        "ASSEMBLY PLATE SCANNER" & vbCrLf

    report = report & _
        "====================================================" & vbCrLf & vbCrLf

    report = report & _
        "Assembly: " & asmDoc.DisplayName & vbCrLf

    report = report & _
        "Date: " & DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss") & vbCrLf

    report = report & vbCrLf


    '=======================================================
    ' COUNTERS
    '=======================================================

    Dim TotalComponents As Integer = 0
    Dim TotalParts As Integer = 0
    Dim TotalSheetMetal As Integer = 0
    Dim TotalCandidates As Integer = 0
    Dim TotalEligible As Integer = 0


    '=======================================================
    ' SCAN TOP LEVEL
    '=======================================================

    Dim occurrences As ComponentOccurrences

    occurrences = asmDoc.ComponentDefinition.Occurrences


    For Each occurrence As ComponentOccurrence In occurrences

        ScanOccurrence( _
            occurrence, _
            0, _
            report, _
            TotalComponents, _
            TotalParts, _
            TotalSheetMetal, _
            TotalCandidates, _
            TotalEligible, _
            RequiredFilenamePrefix)

    Next


    '=======================================================
    ' SUMMARY
    '=======================================================

    report = report & vbCrLf

    report = report & _
        "====================================================" & vbCrLf

    report = report & _
        "SUMMARY" & vbCrLf

    report = report & _
        "====================================================" & vbCrLf

    report = report & _
        "Total components:       " & TotalComponents & vbCrLf

    report = report & _
        "Total parts:            " & TotalParts & vbCrLf

    report = report & _
        "Sheet metal parts:      " & TotalSheetMetal & vbCrLf

    report = report & _
        "Plate candidates:       " & TotalCandidates & vbCrLf

    report = report & _
        "Eligible for nibs:      " & TotalEligible & vbCrLf


    '=======================================================
    ' DISPLAY
    '=======================================================

    'MessageBox has a practical size limit.
    'For a large assembly the report can therefore become
    'too large.
    '
    'For the first test, display it directly.

    MessageBox.Show( _
        report, _
        "Assembly Plate Scanner")

End Sub


'===========================================================
' RECURSIVE OCCURRENCE SCANNER
'===========================================================

Sub ScanOccurrence( _
    occurrence As ComponentOccurrence, _
    level As Integer, _
    ByRef report As String, _
    ByRef TotalComponents As Integer, _
    ByRef TotalParts As Integer, _
    ByRef TotalSheetMetal As Integer, _
    ByRef TotalCandidates As Integer, _
    ByRef TotalEligible As Integer, _
    RequiredFilenamePrefix As String)


    TotalComponents = TotalComponents + 1


    '-------------------------------------------------------
    ' Indentation
    '-------------------------------------------------------

    Dim indent As String = ""

    For i As Integer = 1 To level

        indent = indent & "    "

    Next


    '-------------------------------------------------------
    ' Basic occurrence information
    '-------------------------------------------------------

    Dim occurrenceName As String = occurrence.Name

    Dim fileName As String = ""
    Dim fullPath As String = ""


    Try

        fullPath = occurrence.Definition.Document.FullFileName

        If fullPath <> "" Then

            fileName = Path.GetFileName(fullPath)

        End If

    Catch

        fileName = "(unresolved)"

    End Try


    '-------------------------------------------------------
    ' ASSEMBLY
    '-------------------------------------------------------

    If occurrence.DefinitionDocumentType = _
        DocumentTypeEnum.kAssemblyDocumentObject Then


        report = report & _
            indent & "┌─ ASSEMBLY" & vbCrLf

        report = report & _
            indent & "│  " & occurrenceName & vbCrLf

        report = report & _
            indent & "│  File: " & fileName & vbCrLf


        '---------------------------------------------------
        ' Scan children
        '---------------------------------------------------

        Try

            Dim children As ComponentOccurrences

            children = occurrence.SubOccurrences


            For Each child As ComponentOccurrence _
                In children

                ScanOccurrence( _
                    child, _
                    level + 1, _
                    report, _
                    TotalComponents, _
                    TotalParts, _
                    TotalSheetMetal, _
                    TotalCandidates, _
                    TotalEligible, _
                    RequiredFilenamePrefix)

            Next


        Catch

            report = report & _
                indent & "│  ERROR: Unable to scan subassembly" & vbCrLf

        End Try


        report = report & vbCrLf

        Exit Sub

    End If


    '-------------------------------------------------------
    ' Ignore anything that isn't a part
    '-------------------------------------------------------

    If occurrence.DefinitionDocumentType <> _
        DocumentTypeEnum.kPartDocumentObject Then

        Exit Sub

    End If


    TotalParts = TotalParts + 1


    '=======================================================
    ' PART RECORD
    '=======================================================

    Dim partDoc As PartDocument

    Try

        partDoc = occurrence.Definition.Document

    Catch

        report = report & _
            indent & "┌─ PART - UNRESOLVED" & vbCrLf

        report = report & _
            indent & "│  " & occurrenceName & vbCrLf

        report = report & vbCrLf

        Exit Sub

    End Try


    '-------------------------------------------------------
    ' Determine sheet metal
    '-------------------------------------------------------

    Dim IsSheetMetal As Boolean = False


    Try

        If partDoc.SubType = _
            "{9C6D8F8E-1A4E-11D3-BE70-0060B0E6D4F5}" Then

            IsSheetMetal = True

        End If

    Catch

        IsSheetMetal = False

    End Try


    If IsSheetMetal Then

        TotalSheetMetal = TotalSheetMetal + 1

    End If


    '-------------------------------------------------------
    ' Only sheet metal is currently considered a candidate
    '-------------------------------------------------------

    If Not IsSheetMetal Then

        report = report & _
            indent & "┌─ PART" & vbCrLf

        report = report & _
            indent & "│  Name: " & occurrenceName & vbCrLf

        report = report & _
            indent & "│  File: " & fileName & vbCrLf

        report = report & _
            indent & "│  Sheet Metal: NO" & vbCrLf

        report = report & _
            indent & "│  Result: IGNORE" & vbCrLf

        report = report & vbCrLf

        Exit Sub

    End If


    '=======================================================
    ' THIS IS A SHEET METAL PART
    '=======================================================

    TotalCandidates = TotalCandidates + 1


    '-------------------------------------------------------
    ' iProperties
    '-------------------------------------------------------

    Dim PartNumber As String = ""
    Dim Description As String = ""
    Dim Material As String = ""


    Try

        PartNumber = _
            partDoc.PropertySets( _
                "Design Tracking Properties"). _
                Item("Part Number").Value.ToString()

    Catch

        PartNumber = "(not set)"

    End Try


    Try

        Description = _
            partDoc.PropertySets( _
                "Design Tracking Properties"). _
                Item("Description").Value.ToString()

    Catch

        Description = "(not set)"

    End Try


    Try

        Material = _
            partDoc.PropertySets( _
                "Design Tracking Properties"). _
                Item("Material").Value.ToString()

    Catch

        Material = "(not set)"

    End Try


    '=======================================================
    ' SHEET METAL THICKNESS
    '=======================================================

    Dim Thickness As String = "(unknown)"


    Try

        Dim smDef As SheetMetalComponentDefinition

        smDef = partDoc.ComponentDefinition


        Dim thicknessValue As Double

        thicknessValue = smDef.Thickness.Value


        'Inventor internal length units are cm.
        'Convert to mm.

        Dim thicknessMM As Double

        thicknessMM = thicknessValue * 10


        Thickness = _
            thicknessMM.ToString("0.00") & " mm"


    Catch

        Thickness = "(unknown)"

    End Try


    '=======================================================
    ' NAMING CONVENTION CHECK
    '=======================================================

    Dim NamingMatch As Boolean = True


    If RequiredFilenamePrefix <> "" Then

        If fileName.ToUpper().StartsWith( _
            RequiredFilenamePrefix.ToUpper()) Then

            NamingMatch = True

        Else

            NamingMatch = False

        End If

    End If


    '=======================================================
    ' DETERMINE ELIGIBILITY
    '=======================================================

    Dim Eligible As Boolean = True

    Dim Reason As String = ""


    If Not NamingMatch Then

        Eligible = False

        Reason = _
            "Filename does not match naming convention."

    End If


    If Eligible Then

        TotalEligible = TotalEligible + 1

    End If


    '=======================================================
    ' WRITE CANDIDATE RECORD
    '=======================================================

    report = report & vbCrLf

    report = report & _
        indent & "╔════════════════════════════════════════════════" & vbCrLf

    report = report & _
        indent & "║ PLATE CANDIDATE" & vbCrLf

    report = report & _
        indent & "╠════════════════════════════════════════════════" & vbCrLf


    report = report & _
        indent & "║ Occurrence:    " & occurrenceName & vbCrLf

    report = report & _
        indent & "║ File:          " & fileName & vbCrLf

    report = report & _
        indent & "║ Path:          " & fullPath & vbCrLf

    report = report & _
        indent & "║ Sheet Metal:   YES" & vbCrLf

    r

    If RequiredFilenamePrefix <> "" Then

        report = report & _
            indent & "║ Naming Check:  " & _
            IIf(NamingMatch, "PASS", "FAIL") & vbCrLf

    Else

        report = report & _
            indent & "║ Naming Check:  DISABLED" & vbCrLf

    End If


    report = report & _
        indent & "║" & vbCrLf


    If Eligible Then

        report = report & _
            indent & "║ RESULT:        ELIGIBLE" & vbCrLf

    Else

        report = report & _
            indent & "║ RESULT:        NOT ELIGIBLE" & vbCrLf

        report = report & _
            indent & "║ REASON:        " & Reason & vbCrLf

    End If


    report = report & _
        indent & "╚════════════════════════════════════════════════" & vbCrLf


End Subeport = report & _
        indent & "║ Thickness:     " & Thickness & vbCrLf

    report = report & _
        indent & "║ Part Number:   " & PartNumber & vbCrLf

    report = report & _
        indent & "║ Description:   " & Description & vbCrLf

    report = report & _
        indent & "║ Material:      " & Material & vbCrLf

    report = report & _
        indent & "║" & vbCrLf

```
