' ============================================================
' INVENTOR NIB AUTOMATION
'
' Assembly / Plate Scanner + Nib Edge Analysis (analysis only)
'
' Version: 0.4.7
'
' Purpose:
'   - Scan the active Inventor assembly
'   - Recursively scan subassemblies
'   - Validate assembly naming
'   - Validate part naming
'   - Identify PL components
'   - Identify sheet metal parts
'   - Measure physical plate thickness from geometry
'   - Warn only if sheet-metal parameter thickness differs
'   - Analyse internal openings and/or external boundaries using a selected profile
'   - Use independent internal-opening and external-perimeter clearances / usable lengths
'   - Calculate assembly-space candidate positions and display temporary client-graphics markers
'   - Reject edges with insufficient usable length or nib separation
'   - Produce a centralised diagnostic log
'
' IMPORTANT: This version does NOT insert nibs or modify model geometry/constraints.
' Temporary client graphics are displayed in the active assembly and are not saved with it.
'
' ============================================================


' ============================================================
' MAIN
' ============================================================

Sub Main()

    ' --------------------------------------------------------
    ' SETTINGS
    ' --------------------------------------------------------

    Dim PlateComponentType As String = "PL"

    ' Difference allowed between physical and sheet-metal
    ' parameter thickness before a warning is generated.
    Dim ThicknessWarningToleranceMM As Double = 0.1

    ' Nib analysis settings. These are initial test values and
    ' should be confirmed against the engineering standard.
    Dim MinimumNibEdgeLengthMM As Double = 150.0
    Dim ExternalEndClearanceMM As Double = 75.0
    Dim InternalEndClearanceMM As Double = 50.0
    Dim MaximumNibSpacingMM As Double = 300.0
    Dim ExternalMinimumUsableLengthMM As Double = 150.0
    Dim InternalMinimumUsableLengthMM As Double = 150.0
    Dim MinimumNibCentreSeparationMM As Double = 150.0

    ' Marker graphics are collected in assembly coordinates and drawn once
    ' after scanning. They are temporary ClientGraphics, not model features.
    Dim InternalMarkerCoordinates As New System.Collections.ArrayList
    Dim ExternalMarkerCoordinates As New System.Collections.ArrayList
    Dim RootAssemblyTransform As Inventor.Matrix = ThisApplication.TransientGeometry.CreateMatrix()

    ' Ask for one profile per run. No individual edge selection
    ' is required; geometry detection is automatic.
    Dim NibProfiles As String() = { _
        "Internal openings - all suitable edges", _
        "Internal openings - long edges only", _
        "Internal openings + external perimeter", _
        "External perimeter only"}

    ' --------------------------------------------------------
    ' START LOGGER
    ' --------------------------------------------------------

    Logger.Start()

    Logger.Section("STARTING ASSEMBLY SCAN")


    Try

        ' ----------------------------------------------------
        ' INVENTOR INFORMATION
        ' ----------------------------------------------------

        Logger.Info( _
            "Inventor version: " & _
            ThisApplication.SoftwareVersion.ToString())


        ' ----------------------------------------------------
        ' GET ACTIVE DOCUMENT
        ' ----------------------------------------------------

        Dim ActiveDoc As Inventor.Document = _
            ThisApplication.ActiveDocument


        If ActiveDoc Is Nothing Then

            Logger.Error( _
                "No active document found.")

            ShowLog()

            Exit Sub

        End If


        Logger.Info( _
            "Active document: " & _
            ActiveDoc.DisplayName)


        ' ----------------------------------------------------
        ' CHECK DOCUMENT TYPE
        ' ----------------------------------------------------

        If ActiveDoc.DocumentType <> _
            Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then

            Logger.Error( _
                "Active document is not an assembly.")

            Logger.Info( _
                "Please open an assembly before running the scanner.")

            ShowLog()

            Exit Sub

        End If


        ' ----------------------------------------------------
        ' CONVERT TO ASSEMBLY DOCUMENT
        ' ----------------------------------------------------

        Dim AssemblyDoc As Inventor.AssemblyDocument = _
            CType( _
                ActiveDoc, _
                Inventor.AssemblyDocument)


        ' Ask for one profile per run, after confirming that an
        ' assembly is active. No individual edge selection is needed.
        Dim NibProfile As String = InputListBox( _
            "Choose the nibbing profile for this analysis run.", _
            NibProfiles, _
            NibProfiles(0), _
            "Inventor Nib Automation - Profile", _
            "Nibbing profiles")

        If String.IsNullOrWhiteSpace(NibProfile) Then
            NibProfile = NibProfiles(0)
        End If


        ' ----------------------------------------------------
        ' ASSEMBLY INFORMATION
        ' ----------------------------------------------------

        Logger.Section("ASSEMBLY INFORMATION")


        Dim AssemblyName As String = _
            System.IO.Path.GetFileNameWithoutExtension( _
                AssemblyDoc.FullFileName)


        Logger.Info( _
            "Assembly filename: " & _
            AssemblyName)


        Dim AssemblyData As AssemblyNameData = _
            ParseAssemblyName(AssemblyName)


        If AssemblyData.IsValid Then

            Logger.Success( _
                "Assembly naming convention: PASS")

            Logger.Info( _
                "Project: " & _
                AssemblyData.ProjectNumber)

            Logger.Info( _
                "Description: " & _
                AssemblyData.Description)

            Logger.Info( _
                "Assembly type: " & _
                AssemblyData.AssemblyType)

            Logger.Info( _
                "Assembly number: " & _
                AssemblyData.AssemblyNumber)

            Logger.Info( _
                "Revision: " & _
                AssemblyData.Revision)

        Else

            Logger.Warning( _
                "Assembly naming convention: FAIL")

        End If


        ' ----------------------------------------------------
        ' COUNTERS
        ' ----------------------------------------------------

        Dim TotalOccurrences As Integer = 0

        Dim TotalParts As Integer = 0

        Dim SheetMetalParts As Integer = 0

        Dim PLComponents As Integer = 0

        Dim EligiblePlates As Integer = 0

        Dim InvalidNames As Integer = 0

        Dim SubAssemblies As Integer = 0


        ' ----------------------------------------------------
        ' SCAN ASSEMBLY
        ' ----------------------------------------------------

        Logger.Section("SCANNING COMPONENTS")

        Logger.Info("Nibbing profile: " & NibProfile)
        Logger.Info("Minimum candidate edge length: " & MinimumNibEdgeLengthMM & " mm")
        Logger.Info("External perimeter end clearance: " & ExternalEndClearanceMM & " mm")
        Logger.Info("Internal opening end clearance: " & InternalEndClearanceMM & " mm")
        Logger.Info("Maximum nib centre-to-centre spacing: " & MaximumNibSpacingMM & " mm")
        Logger.Info("External minimum usable edge length: " & ExternalMinimumUsableLengthMM & " mm")
        Logger.Info("Internal minimum usable edge length: " & InternalMinimumUsableLengthMM & " mm")
        Logger.Info("Minimum nib centre-to-centre separation: " & MinimumNibCentreSeparationMM & " mm")
        Logger.Warning("Analysis-only mode: no nibs will be inserted and no geometry will be changed.")

        ScanOccurrences( _
            AssemblyDoc.ComponentDefinition.Occurrences, _
            PlateComponentType, _
            ThicknessWarningToleranceMM, _
            NibProfile, _
            MinimumNibEdgeLengthMM, _
            ExternalEndClearanceMM, _
            InternalEndClearanceMM, _
            MaximumNibSpacingMM, _
            ExternalMinimumUsableLengthMM, _
            InternalMinimumUsableLengthMM, _
            MinimumNibCentreSeparationMM, _
            InternalMarkerCoordinates, _
            ExternalMarkerCoordinates, _
            RootAssemblyTransform, _
            TotalOccurrences, _
            TotalParts, _
            SheetMetalParts, _
            PLComponents, _
            EligiblePlates, _
            InvalidNames, _
            SubAssemblies)

        DrawNibCandidateMarkers(AssemblyDoc, InternalMarkerCoordinates, ExternalMarkerCoordinates)


        ' ----------------------------------------------------
        ' SUMMARY
        ' ----------------------------------------------------

        Logger.Section("SCAN SUMMARY")


        Logger.Info( _
            "Assemblies found: " & _
            SubAssemblies)


        Logger.Info( _
            "Total occurrences: " & _
            TotalOccurrences)


        Logger.Info( _
            "Total parts: " & _
            TotalParts)


        Logger.Info( _
            "Sheet metal parts: " & _
            SheetMetalParts)


        Logger.Info( _
            "PL components: " & _
            PLComponents)


        Logger.Info( _
            "Eligible plates: " & _
            EligiblePlates)


        Logger.Info( _
            "Invalid filenames: " & _
            InvalidNames)


        ' ----------------------------------------------------
        ' COMPLETE
        ' ----------------------------------------------------

        Logger.Section("SCAN COMPLETE")


        Logger.Success( _
            "Assembly scan completed.")


    Catch ex As Exception

        ' ----------------------------------------------------
        ' UNEXPECTED ERROR
        ' ----------------------------------------------------

        Logger.Error( _
            "UNEXPECTED ERROR")

        Logger.Error( _
            ex.Message)

        Logger.Debug( _
            ex.StackTrace)

    End Try


    ' --------------------------------------------------------
    ' SHOW LOG
    ' --------------------------------------------------------

    ShowLog()


End Sub



' ============================================================
' RECURSIVE ASSEMBLY SCANNER
' ============================================================

Sub ScanOccurrences( _
    Occurrences As Inventor.ComponentOccurrences, _
    PlateComponentType As String, _
    ThicknessWarningToleranceMM As Double, _
    NibProfile As String, _
    MinimumNibEdgeLengthMM As Double, _
    ExternalEndClearanceMM As Double, _
    InternalEndClearanceMM As Double, _
    MaximumNibSpacingMM As Double, _
    ExternalMinimumUsableLengthMM As Double, _
    InternalMinimumUsableLengthMM As Double, _
    MinimumNibCentreSeparationMM As Double, _
    InternalMarkerCoordinates As System.Collections.ArrayList, _
    ExternalMarkerCoordinates As System.Collections.ArrayList, _
    ParentAssemblyTransform As Inventor.Matrix, _
    ByRef TotalOccurrences As Integer, _
    ByRef TotalParts As Integer, _
    ByRef SheetMetalParts As Integer, _
    ByRef PLComponents As Integer, _
    ByRef EligiblePlates As Integer, _
    ByRef InvalidNames As Integer, _
    ByRef SubAssemblies As Integer)


    ' --------------------------------------------------------
    ' LOOP THROUGH OCCURRENCES
    ' --------------------------------------------------------

    For Each Occurrence As Inventor.ComponentOccurrence _
        In Occurrences

        Dim CurrentOccurrenceTransform As Inventor.Matrix = ParentAssemblyTransform.Copy()
        CurrentOccurrenceTransform.PostMultiplyBy(Occurrence.Transformation)

        TotalOccurrences += 1


        Logger.Debug( _
            "Inspecting occurrence: " & _
            Occurrence.Name)


        ' ====================================================
        ' SUPPRESSED COMPONENT
        ' ====================================================

        If Occurrence.Suppressed Then

            Logger.Warning( _
                Occurrence.Name & _
                " is suppressed - skipped.")

            Continue For

        End If


        ' ====================================================
        ' CHECK FOR SUBASSEMBLY
        ' ====================================================

        If Occurrence.DefinitionDocumentType = _
            Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then


            SubAssemblies += 1


            Dim SubAssemblyDoc As Inventor.AssemblyDocument = _
                CType( _
                    Occurrence.Definition.Document, _
                    Inventor.AssemblyDocument)


            Dim SubAssemblyName As String = _
                System.IO.Path.GetFileNameWithoutExtension( _
                    SubAssemblyDoc.FullFileName)


            Logger.Section("SUBASSEMBLY")


            Logger.Info( _
                "Name: " & _
                SubAssemblyName)


            ' ------------------------------------------------
            ' PARSE SUBASSEMBLY NAME
            ' ------------------------------------------------

            Dim SubAssemblyData As AssemblyNameData = _
                ParseAssemblyName(SubAssemblyName)


            If SubAssemblyData.IsValid Then

                Logger.Success( _
                    "Naming convention: PASS")

            Else

                Logger.Warning( _
                    "Subassembly naming convention: FAIL")

            End If


            ' ------------------------------------------------
            ' RECURSE INTO SUBASSEMBLY
            ' ------------------------------------------------

            ScanOccurrences( _
                SubAssemblyDoc.ComponentDefinition.Occurrences, _
                PlateComponentType, _
                ThicknessWarningToleranceMM, _
                NibProfile, _
                MinimumNibEdgeLengthMM, _
                ExternalEndClearanceMM, _
                InternalEndClearanceMM, _
                MaximumNibSpacingMM, _
                ExternalMinimumUsableLengthMM, _
                InternalMinimumUsableLengthMM, _
                MinimumNibCentreSeparationMM, _
                InternalMarkerCoordinates, _
                ExternalMarkerCoordinates, _
                CurrentOccurrenceTransform, _
                TotalOccurrences, _
                TotalParts, _
                SheetMetalParts, _
                PLComponents, _
                EligiblePlates, _
                InvalidNames, _
                SubAssemblies)


            Continue For


        End If


        ' ====================================================
        ' PART
        ' ====================================================

        TotalParts += 1


        Dim PartDoc As Inventor.PartDocument = _
            CType( _
                Occurrence.Definition.Document, _
                Inventor.PartDocument)


        Dim PartName As String = _
            System.IO.Path.GetFileNameWithoutExtension( _
                PartDoc.FullFileName)


        Logger.Section("PART")


        Logger.Info( _
            "Occurrence: " & _
            Occurrence.Name)


        Logger.Info( _
            "Filename: " & _
            PartName)


        ' ====================================================
        ' PARSE PART NAME
        ' ====================================================

        Dim PartData As PartNameData = _
            ParsePartName(PartName)


        If Not PartData.IsValid Then

            InvalidNames += 1


            Logger.Warning( _
                "Part naming convention: FAIL")

            Logger.Warning( _
                "Unable to determine component type.")

            Continue For

        End If


        Logger.Success( _
            "Part naming convention: PASS")


        ' ====================================================
        ' CHECK COMPONENT TYPE
        ' ====================================================

        If PartData.ComponentType <> _
            PlateComponentType Then


            Logger.Info( _
                "Component type is not " & _
                PlateComponentType & _
                " - ignored.")

            Continue For

        End If


        PLComponents += 1


        Logger.Info( _
            "Component identified as PL plate.")


        ' ====================================================
        ' CHECK SHEET METAL
        ' ====================================================

        Dim IsSheetMetal As Boolean = _
            IsSheetMetalPart(PartDoc)


        If IsSheetMetal Then

            SheetMetalParts += 1


            Logger.Success( _
                "Sheet metal check: PASS")

        Else

            Logger.Warning( _
                "Sheet metal check: FAIL")

            Logger.Warning( _
                "PL component is not recognised as sheet metal.")

            Continue For

        End If


        ' ====================================================
        ' PHYSICAL THICKNESS
        '
        ' The thickness displayed here comes from the physical
        ' geometry, NOT the sheet-metal parameter.
        '
        ' The sheet-metal parameter is only checked internally
        ' so that a warning can be generated if it disagrees.
        ' ====================================================

        Dim PhysicalThicknessMM As Double = 0

        Dim ParameterThicknessMM As Double = 0


        PhysicalThicknessMM = _
            GetPhysicalPlateThicknessMM( _
                PartDoc, _
                ParameterThicknessMM)


        If PhysicalThicknessMM > 0 Then


            ' ------------------------------------------------
            ' PHYSICAL THICKNESS
            ' ------------------------------------------------

            Logger.Info( _
                "Physical thickness: " & _
                Math.Round( _
                    PhysicalThicknessMM, _
                    3) & _
                " mm")


            ' ------------------------------------------------
            ' PARAMETER DISCREPANCY WARNING
            ' ------------------------------------------------

            If ParameterThicknessMM > 0 Then

                Dim ThicknessDifferenceMM As Double = _
                    Math.Abs( _
                        PhysicalThicknessMM - _
                        ParameterThicknessMM)


                If ThicknessDifferenceMM > _
                    ThicknessWarningToleranceMM Then

                    Logger.Warning( _
                        "Sheet-metal parameter thickness is " & _
                        Math.Round( _
                            ParameterThicknessMM, _
                            3) & _
                        " mm; physical thickness is " & _
                        Math.Round( _
                            PhysicalThicknessMM, _
                            3) & _
                        " mm.")

                End If

            End If


        Else

            Logger.Warning( _
                "Physical plate thickness could not be determined.")

            Continue For

        End If


        ' ====================================================
        ' CURRENT PLATE ELIGIBILITY
        ' ====================================================

        EligiblePlates += 1


        Logger.Success( _
            "PLATE ELIGIBILITY: PASS")


        ' ====================================================
        ' NIB EDGE ANALYSIS (REPORT ONLY)
        ' ====================================================

        AnalyzePlateGeometry( _
            PartDoc,
            Occurrence.Name,
            NibProfile,
            PhysicalThicknessMM,
            CurrentOccurrenceTransform,
            MinimumNibEdgeLengthMM,
            ExternalEndClearanceMM,
            InternalEndClearanceMM,
            MaximumNibSpacingMM,
            ExternalMinimumUsableLengthMM,
            InternalMinimumUsableLengthMM,
            MinimumNibCentreSeparationMM,
            InternalMarkerCoordinates,
            ExternalMarkerCoordinates)

        ' Nib selection and insertion are intentionally not called.


    Next


End Sub



 ' ============================================================
' NIB EDGE ANALYSIS - REPORT ONLY
'
' Version 0.4.5: vector-angle edge orientation classification.
'
' Version 0.4.4 geometry strategy:
'   - Identify the broad planar face, not merely any planar face.
'   - Rank planar faces first by how many boundary edges are much
'     longer than the measured sheet thickness, then by face area.
'   - Analyse only boundary loops belonging to that broad face.
'   - Report in-plane, thickness-direction and ambiguous edge orientations.
'   - Classify straight edges by comparing their direction with the selected
'     broad face normal (vector-angle method).
'   - Use physical thickness only as a secondary sanity check.
'   - Apply the selected nib profile after geometric classification.
'   - Use independent clearances for internal openings and external perimeters.
'   - Transform calculated nib centres into assembly coordinates and draw temporary markers.
'   - Calculate positions only; never insert nibs or modify assembly.
'
' This is intended to handle rotated plates and angled outlines because
' it does not depend on global X/Y/Z directions or rectangular shapes.
' ============================================================

Sub AnalyzePlateGeometry( _
    PartDoc As Inventor.PartDocument, _
    OccurrenceName As String, _
    NibProfile As String, _
    PhysicalThicknessMM As Double, _
    OccurrenceTransform As Inventor.Matrix, _
    MinimumNibEdgeLengthMM As Double, _
    ExternalEndClearanceMM As Double, _
    InternalEndClearanceMM As Double, _
    MaximumNibSpacingMM As Double, _
    ExternalMinimumUsableLengthMM As Double, _
    InternalMinimumUsableLengthMM As Double, _
    MinimumNibCentreSeparationMM As Double, _
    InternalMarkerCoordinates As System.Collections.ArrayList, _
    ExternalMarkerCoordinates As System.Collections.ArrayList)

    Logger.Section("NIB EDGE ANALYSIS")
    Logger.Info("Occurrence: " & OccurrenceName)
    Logger.Info("Part file: " & System.IO.Path.GetFileNameWithoutExtension(PartDoc.FullFileName))
    Logger.Info("Selected profile: " & NibProfile)
    Logger.Info("Measured physical thickness supplied to analyser: " & _
                Math.Round(PhysicalThicknessMM, 3) & " mm")

    ' Angular tolerance used when comparing edge direction with the plate normal.
    ' One degree is a starting diagnostic tolerance, not an engineering standard.
    Dim OrientationToleranceDegrees As Double = 1.0
    Logger.Info("Edge orientation angular tolerance: " & OrientationToleranceDegrees & " degrees")
    Logger.Info("External perimeter end clearance: " & ExternalEndClearanceMM & " mm")
    Logger.Info("Internal opening end clearance: " & InternalEndClearanceMM & " mm")
    Logger.Info("Maximum centre-to-centre spacing: " & MaximumNibSpacingMM & " mm")
    Logger.Info("External minimum usable length: " & ExternalMinimumUsableLengthMM & " mm")
    Logger.Info("Internal minimum usable length: " & InternalMinimumUsableLengthMM & " mm")
    Logger.Info("Minimum centre-to-centre separation: " & MinimumNibCentreSeparationMM & " mm")

    Dim PartDef As Inventor.PartComponentDefinition = Nothing
    Try
        PartDef = CType(PartDoc.ComponentDefinition, Inventor.PartComponentDefinition)
    Catch ex As Exception
        Logger.Warning("Geometry analysis skipped: unable to access part definition. " & ex.Message)
        Exit Sub
    End Try

    Dim BodiesAnalysed As Integer = 0
    Dim LoopsAnalysed As Integer = 0
    Dim EdgesAnalysed As Integer = 0
    Dim CandidateEdges As Integer = 0
    Dim RejectedEdges As Integer = 0
    Dim CandidatePositions As Integer = 0
    Dim BodyIndex As Integer = 0

    Logger.Info("Surface bodies found: " & PartDef.SurfaceBodies.Count)

    For Each Body As Inventor.SurfaceBody In PartDef.SurfaceBodies
        BodyIndex += 1
        If Body Is Nothing Then Continue For

        Logger.Info("Body " & BodyIndex & ": IsSolid=" & Body.IsSolid & _
                    "; faces=" & Body.Faces.Count)

        If Not Body.IsSolid Then
            Logger.Warning("Body " & BodyIndex & " is a surface body, not a solid body; skipped.")
            Continue For
        End If

        ' Find the broad planar face. The existing thickness-aware boundary score
        ' selects a likely broad face; edge orientation is then classified
        ' independently by comparing each edge direction with that face normal.
        Dim MainFace As Inventor.Face = Nothing
        Dim BestLongBoundaryEdgeCount As Integer = -1
        Dim BestFaceArea As Double = -1
        Dim PlanarFacesFound As Integer = 0
        Dim FaceIndex As Integer = 0
        Dim ThicknessScaleThresholdMM As Double = Math.Max(PhysicalThicknessMM * 2.0, 1.0)

        For Each Face As Inventor.Face In Body.Faces
            FaceIndex += 1
            If Face Is Nothing Then Continue For
            If Not IsPlanarFaceForAnalysis(Face) Then Continue For

            PlanarFacesFound += 1
            Dim FaceArea As Double = TryGetFaceArea(Face)
            Dim FaceAreaStatus As String = If(FaceArea > 0, "AREA AVAILABLE", "AREA UNAVAILABLE/ZERO")
            Dim LongBoundaryEdgeCount As Integer = CountLongBoundaryEdges( _
                PartDoc, Face, ThicknessScaleThresholdMM)

            Logger.Debug("Body " & BodyIndex & ", face " & FaceIndex & _
                         ": planar area=" & Math.Round(FaceArea, 6) & " (database area units; " & FaceAreaStatus & ")" & _
                         "; boundary edges longer than " & _
                         Math.Round(ThicknessScaleThresholdMM, 3) & " mm=" & _
                         LongBoundaryEdgeCount)

            If LongBoundaryEdgeCount > BestLongBoundaryEdgeCount OrElse _
               (LongBoundaryEdgeCount = BestLongBoundaryEdgeCount AndAlso FaceArea > BestFaceArea) Then
                MainFace = Face
                BestLongBoundaryEdgeCount = LongBoundaryEdgeCount
                BestFaceArea = FaceArea
            End If
        Next

        Logger.Info("Body " & BodyIndex & ": planar faces recognised=" & PlanarFacesFound)

        If MainFace Is Nothing Then
            Logger.Warning("No planar face found on body " & BodyIndex & "; body skipped. " & _
                           "No fallback to a non-planar/side face was used, to avoid false edge candidates.")
            Continue For
        End If

        If BestLongBoundaryEdgeCount < 3 Then
            Logger.Warning("Selected face on body " & BodyIndex & " has only " & _
                           BestLongBoundaryEdgeCount & " boundary edges longer than the thickness threshold. " & _
                           "The geometry may not expose a clear broad plate face; results require review.")
        End If

        BodiesAnalysed += 1
        Logger.Info("Selected broad planar face on body " & BodyIndex & _
                    "; area=" & Math.Round(Math.Max(0, BestFaceArea), 6) & _
                    " database area units (diagnostic/tie-break only); long boundary edges=" & _
                    BestLongBoundaryEdgeCount & "; edge loops=" & MainFace.EdgeLoops.Count)

        For Each BoundaryLoop As Inventor.EdgeLoop In MainFace.EdgeLoops
            LoopsAnalysed += 1

            Dim IsOuterLoop As Boolean = False
            Try
                IsOuterLoop = BoundaryLoop.IsOuterEdgeLoop
            Catch ex As Exception
                Logger.Warning("Unable to classify boundary loop " & LoopsAnalysed & _
                               "; loop skipped. " & ex.Message)
                Continue For
            End Try

            Dim LoopType As String = If(IsOuterLoop, "EXTERNAL PERIMETER", "INTERNAL OPENING")
            Dim IncludeLoop As Boolean = False

            Select Case NibProfile
                Case "Internal openings - all suitable edges", "Internal openings - long edges only"
                    IncludeLoop = Not IsOuterLoop
                Case "Internal openings + external perimeter"
                    IncludeLoop = True
                Case "External perimeter only"
                    IncludeLoop = IsOuterLoop
                Case Else
                    IncludeLoop = Not IsOuterLoop
            End Select

            Logger.Info("Boundary loop " & LoopsAnalysed & ": " & LoopType & _
                        If(IncludeLoop, " [IN SCOPE]", " [EXCLUDED BY PROFILE]"))

            Dim LongestStraightEdgeMM As Double = 0
            For Each Edge As Inventor.Edge In BoundaryLoop.Edges
                Dim ThisLengthMM As Double = GetStraightEdgeLengthMM(PartDoc, Edge)
                If ThisLengthMM > LongestStraightEdgeMM Then LongestStraightEdgeMM = ThisLengthMM
            Next

            For Each Edge As Inventor.Edge In BoundaryLoop.Edges
                EdgesAnalysed += 1

                Dim EdgeLengthMM As Double = GetStraightEdgeLengthMM(PartDoc, Edge)
                Dim IsStraight As Boolean = IsStraightEdge(Edge)
                Dim AlignmentWithNormal As Double = -1.0
                Dim OrientationClass As String = ClassifyEdgeAgainstFaceNormal( _
                    MainFace, Edge, OrientationToleranceDegrees, AlignmentWithNormal)

                ' Thickness is retained as a secondary validation only. The primary
                ' orientation decision comes from the edge/face-normal vector comparison.
                Dim IsThicknessScaleEdge As Boolean = False
                If PhysicalThicknessMM > 0 AndAlso IsStraight Then
                    IsThicknessScaleEdge = (EdgeLengthMM <= PhysicalThicknessMM * 1.5)
                End If

                Dim IsCandidate As Boolean = IncludeLoop
                Dim Reason As String = "Boundary permitted by selected profile"

                If Not IsStraight Then
                    IsCandidate = False
                    Reason = "Curved edge not supported by initial analyser"
                ElseIf OrientationClass = "THICKNESS-DIRECTION" Then
                    IsCandidate = False
                    Reason = "Edge direction is parallel to the plate normal"
                ElseIf OrientationClass = "AMBIGUOUS" OrElse OrientationClass = "UNAVAILABLE" Then
                    IsCandidate = False
                    Reason = "Edge orientation is ambiguous or could not be calculated"
                ElseIf IsThicknessScaleEdge Then
                    IsCandidate = False
                    Reason = "Thickness-scale length validation failed; review edge geometry"
                ElseIf Not IncludeLoop Then
                    IsCandidate = False
                    Reason = "Boundary excluded by selected profile"
                ElseIf EdgeLengthMM < MinimumNibEdgeLengthMM Then
                    IsCandidate = False
                    Reason = "Below minimum edge length"
                ElseIf EdgeLengthMM <= (2 * If(IsOuterLoop, ExternalEndClearanceMM, InternalEndClearanceMM)) Then
                    IsCandidate = False
                    Reason = "Insufficient length after boundary-specific end clearances"
                ElseIf (EdgeLengthMM - (2 * If(IsOuterLoop, ExternalEndClearanceMM, InternalEndClearanceMM))) < _
                       If(IsOuterLoop, ExternalMinimumUsableLengthMM, InternalMinimumUsableLengthMM) Then
                    IsCandidate = False
                    Reason = "Usable length after boundary-specific end clearances is below the configured minimum"
                ElseIf NibProfile = "Internal openings - long edges only" AndAlso _
                       EdgeLengthMM < (LongestStraightEdgeMM * 0.75) Then
                    IsCandidate = False
                    Reason = "Not a long side under the selected profile heuristic"
                End If

                Logger.Info("Edge " & EdgesAnalysed & _
                            " | Type=" & If(IsStraight, "Straight", "Curved/other") & _
                            " | Length=" & Math.Round(EdgeLengthMM, 2) & " mm" & _
                            " | Orientation=" & OrientationClass & _
                            " | Abs(dot)=" & If(AlignmentWithNormal >= 0, Math.Round(AlignmentWithNormal, 6).ToString(), "N/A") & _
                            " | Boundary=SELECTED FACE LOOP" & _
                            " | " & If(IsCandidate, "CANDIDATE", "REJECTED") & _
                            " | " & Reason)

                If IsCandidate Then
                    Dim EdgeEndClearanceMM As Double = If(IsOuterLoop, ExternalEndClearanceMM, InternalEndClearanceMM)
                    Dim UsableLengthMM As Double = EdgeLengthMM - (2 * EdgeEndClearanceMM)

                    ' Divide the usable span into equal centre-to-centre intervals.
                    ' The first and last nib centres sit exactly at the configured
                    ' end clearances. The interval count must satisfy both bounds.
                    Dim IntervalCount As Integer = CInt(Math.Ceiling(UsableLengthMM / MaximumNibSpacingMM))
                    If IntervalCount < 1 Then IntervalCount = 1
                    Dim ActualSpacingMM As Double = UsableLengthMM / IntervalCount

                    If ActualSpacingMM < MinimumNibCentreSeparationMM Then
                        IsCandidate = False
                        Reason = "Even distribution would violate minimum centre-to-centre separation (" & _
                                 Math.Round(ActualSpacingMM, 2) & " mm < " & MinimumNibCentreSeparationMM & " mm)"
                        RejectedEdges += 1
                        Logger.Info("  REJECTED AFTER DISTRIBUTION CHECK: " & Reason)
                    Else
                        CandidateEdges += 1
                        Logger.Info("  Candidate positions from edge start (mm):")
                        Dim StartVertex As Inventor.Vertex = Edge.StartVertex
                        Dim StopVertex As Inventor.Vertex = Edge.StopVertex
                        If StartVertex Is Nothing OrElse StopVertex Is Nothing Then
                            Logger.Warning("  Candidate positions retained in report only; edge vertices unavailable for visual marker coordinates.")
                        End If
                        For PositionIndex As Integer = 0 To IntervalCount
                            Dim PositionMM As Double = EdgeEndClearanceMM + (PositionIndex * ActualSpacingMM)
                            Logger.Info("    " & Math.Round(PositionMM, 2) & " mm")
                            CandidatePositions += 1
                            If StartVertex IsNot Nothing AndAlso StopVertex IsNot Nothing Then
                                AddCandidateMarkerCoordinate(PartDoc, StartVertex.Point, StopVertex.Point, _
                                    PositionMM, EdgeLengthMM, OccurrenceTransform, IsOuterLoop, _
                                    InternalMarkerCoordinates, ExternalMarkerCoordinates)
                            End If
                        Next
                        Logger.Info("  Boundary type: " & LoopType)
                        Logger.Info("  Applied end clearance: " & EdgeEndClearanceMM & " mm")
                        Logger.Info("  Usable length: " & Math.Round(UsableLengthMM, 2) & " mm")
                        Logger.Info("  Nib centre count: " & (IntervalCount + 1))
                        Logger.Info("  Actual centre-to-centre spacing: " & Math.Round(ActualSpacingMM, 2) & _
                                    " mm; permitted range: " & MinimumNibCentreSeparationMM & " to " & _
                                    MaximumNibSpacingMM & " mm")
                    End If
                Else
                    RejectedEdges += 1
                End If
            Next
        Next
    Next

    Logger.Section("NIB ANALYSIS SUMMARY - " & OccurrenceName)
    Logger.Info("Solid bodies analysed: " & BodiesAnalysed)
    Logger.Info("Boundary loops analysed: " & LoopsAnalysed)
    Logger.Info("Edges inspected: " & EdgesAnalysed)
    Logger.Info("Candidate edges: " & CandidateEdges)
    Logger.Info("Rejected edges: " & RejectedEdges)
    Logger.Info("Calculated candidate positions: " & CandidatePositions)
    Logger.Warning("Candidate positions were transformed into assembly-space temporary markers; no nibs were inserted and no model geometry was changed.")

End Sub


' ============================================================
' TEMPORARY CANDIDATE MARKER GRAPHICS
' ============================================================

Sub AddCandidateMarkerCoordinate( _
    PartDoc As Inventor.PartDocument, _
    StartPoint As Inventor.Point, _
    EndPoint As Inventor.Point, _
    DistanceAlongEdgeMM As Double, _
    EdgeLengthMM As Double, _
    OccurrenceTransform As Inventor.Matrix, _
    IsExternal As Boolean, _
    InternalCoordinates As System.Collections.ArrayList, _
    ExternalCoordinates As System.Collections.ArrayList)

    Try
        If PartDoc Is Nothing OrElse StartPoint Is Nothing OrElse EndPoint Is Nothing Then Exit Sub
        If EdgeLengthMM <= 0 Then Exit Sub

        Dim Fraction As Double = DistanceAlongEdgeMM / EdgeLengthMM
        If Fraction < 0 OrElse Fraction > 1 Then Exit Sub

        ' Inventor database coordinates are centimetres. Interpolate in part
        ' coordinates, then transform into the active assembly coordinate frame.
        Dim X As Double = StartPoint.X + ((EndPoint.X - StartPoint.X) * Fraction)
        Dim Y As Double = StartPoint.Y + ((EndPoint.Y - StartPoint.Y) * Fraction)
        Dim Z As Double = StartPoint.Z + ((EndPoint.Z - StartPoint.Z) * Fraction)
        Dim MarkerPoint As Inventor.Point = ThisApplication.TransientGeometry.CreatePoint(X, Y, Z)
        MarkerPoint.TransformBy(OccurrenceTransform)

        Dim Target As System.Collections.ArrayList = If(IsExternal, ExternalCoordinates, InternalCoordinates)
        Target.Add(CDbl(MarkerPoint.X))
        Target.Add(CDbl(MarkerPoint.Y))
        Target.Add(CDbl(MarkerPoint.Z))
    Catch ex As Exception
        Logger.Debug("Unable to calculate assembly-space marker coordinate: " & ex.Message)
    End Try
End Sub


Sub DrawNibCandidateMarkers( _
    AssemblyDoc As Inventor.AssemblyDocument, _
    InternalCoordinates As System.Collections.ArrayList, _
    ExternalCoordinates As System.Collections.ArrayList)

    If AssemblyDoc Is Nothing Then Exit Sub

    Const GraphicsId As String = "InventorNibAutomation_v047_CandidateMarkers"
    Try
        ' Remove markers from a previous run of this rule, if present.
        Try
            AssemblyDoc.ComponentDefinition.ClientGraphicsCollection.Item(GraphicsId).Delete()
        Catch
        End Try
        Try
            AssemblyDoc.GraphicsDataSetsCollection.Item(GraphicsId).Delete()
        Catch
        End Try

        If InternalCoordinates.Count = 0 AndAlso ExternalCoordinates.Count = 0 Then
            Logger.Warning("No candidate marker coordinates were generated; no visual markers displayed.")
            Exit Sub
        End If

        Dim DataSets As Inventor.GraphicsDataSets = AssemblyDoc.GraphicsDataSetsCollection.Add(GraphicsId)
        Dim ClientGraphics As Inventor.ClientGraphics = AssemblyDoc.ComponentDefinition.ClientGraphicsCollection.Add(GraphicsId)

        If InternalCoordinates.Count > 0 Then
            AddMarkerCrossGraphics(DataSets, ClientGraphics, InternalCoordinates, 1, 0, 180, 255)
        End If
        If ExternalCoordinates.Count > 0 Then
            AddMarkerCrossGraphics(DataSets, ClientGraphics, ExternalCoordinates, 2, 255, 140, 0)
        End If

        ThisApplication.ActiveView.Update()
        Logger.Success("Temporary nib candidate markers displayed in assembly: internal=" & _
                       (InternalCoordinates.Count \ 3) & "; external=" & (ExternalCoordinates.Count \ 3))
        Logger.Info("Marker graphics are transient ClientGraphics and are not saved as model geometry.")
    Catch ex As Exception
        Logger.Warning("Unable to display temporary candidate markers: " & ex.Message)
    End Try
End Sub


Sub AddMarkerCrossGraphics( _
    DataSets As Inventor.GraphicsDataSets, _
    ClientGraphics As Inventor.ClientGraphics, _
    Coordinates As System.Collections.ArrayList, _
    NodeId As Integer, _
    Red As Integer, _
    Green As Integer, _
    Blue As Integer)

    Try
        Dim LineCoordinates As New System.Collections.ArrayList
        ' A small 3D cross (2 mm total span per axis) makes each candidate
        ' visible without creating any sketch, feature, or physical component.
        Dim HalfSizeCM As Double = 0.1
        For i As Integer = 0 To Coordinates.Count - 1 Step 3
            Dim X As Double = CDbl(Coordinates(i))
            Dim Y As Double = CDbl(Coordinates(i + 1))
            Dim Z As Double = CDbl(Coordinates(i + 2))
            LineCoordinates.Add(X - HalfSizeCM) : LineCoordinates.Add(Y) : LineCoordinates.Add(Z)
            LineCoordinates.Add(X + HalfSizeCM) : LineCoordinates.Add(Y) : LineCoordinates.Add(Z)
            LineCoordinates.Add(X) : LineCoordinates.Add(Y - HalfSizeCM) : LineCoordinates.Add(Z)
            LineCoordinates.Add(X) : LineCoordinates.Add(Y + HalfSizeCM) : LineCoordinates.Add(Z)
            LineCoordinates.Add(X) : LineCoordinates.Add(Y) : LineCoordinates.Add(Z - HalfSizeCM)
            LineCoordinates.Add(X) : LineCoordinates.Add(Y) : LineCoordinates.Add(Z + HalfSizeCM)
        Next

        Dim CoordinateSet As Inventor.GraphicsCoordinateSet = DataSets.CreateCoordinateSet(NodeId)
        Dim Values(LineCoordinates.Count - 1) As Double
        For i As Integer = 0 To LineCoordinates.Count - 1
            Values(i) = CDbl(LineCoordinates(i))
        Next
        CoordinateSet.PutCoordinates(Values)

        Dim Node As Inventor.GraphicsNode = ClientGraphics.AddNode(NodeId)
        Node.Selectable = False
        Dim Lines As Inventor.LineGraphics = Node.AddLineGraphics()
        Lines.CoordinateSet = CoordinateSet

        Dim ColorSet As Inventor.GraphicsColorSet = DataSets.CreateColorSet(NodeId)
        ColorSet.Add(1, Red, Green, Blue)
        Lines.ColorSet = ColorSet
    Catch ex As Exception
        Logger.Warning("Unable to create one candidate marker group: " & ex.Message)
    End Try
End Sub


Function ClassifyEdgeAgainstFaceNormal( _
    Face As Inventor.Face, _
    Edge As Inventor.Edge, _
    ToleranceDegrees As Double, _
    ByRef AbsoluteDotProduct As Double) As String

    AbsoluteDotProduct = -1.0
    If Face Is Nothing OrElse Edge Is Nothing Then Return "UNAVAILABLE"

    Try
        If Not IsStraightEdge(Edge) Then Return "UNAVAILABLE"

        Dim PlaneGeometry As Inventor.Plane = CType(Face.Geometry, Inventor.Plane)
        Dim FaceNormal As Inventor.UnitVector = PlaneGeometry.Normal
        Dim LineGeometry As Inventor.LineSegment = CType(Edge.Geometry, Inventor.LineSegment)
        Dim EdgeDirection As Inventor.UnitVector = LineGeometry.Direction

        ' UnitVector components are already normalised. Use the absolute dot
        ' product so reversed edge/face directions classify identically.
        Dim DotValue As Double = _
            (FaceNormal.X * EdgeDirection.X) + _
            (FaceNormal.Y * EdgeDirection.Y) + _
            (FaceNormal.Z * EdgeDirection.Z)

        AbsoluteDotProduct = Math.Abs(DotValue)
        If AbsoluteDotProduct > 1.0 Then AbsoluteDotProduct = 1.0

        Dim ToleranceRadians As Double = ToleranceDegrees * Math.PI / 180.0
        Dim InPlaneLimit As Double = Math.Sin(ToleranceRadians)
        Dim ThicknessLimit As Double = Math.Cos(ToleranceRadians)

        If AbsoluteDotProduct <= InPlaneLimit Then
            Return "IN-PLANE"
        ElseIf AbsoluteDotProduct >= ThicknessLimit Then
            Return "THICKNESS-DIRECTION"
        Else
            Return "AMBIGUOUS"
        End If

    Catch ex As Exception
        Logger.Debug("Edge/face-normal vector comparison failed: " & ex.Message)
        Return "UNAVAILABLE"
    End Try
End Function


Function CountLongBoundaryEdges( _
    PartDoc As Inventor.PartDocument, _
    Face As Inventor.Face, _
    MinimumLongEdgeLengthMM As Double) As Integer

    Dim Count As Integer = 0
    If PartDoc Is Nothing OrElse Face Is Nothing Then Return Count

    Try
        For Each BoundaryLoop As Inventor.EdgeLoop In Face.EdgeLoops
            For Each Edge As Inventor.Edge In BoundaryLoop.Edges
                If IsStraightEdge(Edge) Then
                    If GetStraightEdgeLengthMM(PartDoc, Edge) > MinimumLongEdgeLengthMM Then
                        Count += 1
                    End If
                End If
            Next
        Next
    Catch ex As Exception
        Logger.Debug("Unable to score planar face boundary edges: " & ex.Message)
    End Try

    Return Count
End Function


Function IsPlanarFaceForAnalysis(Face As Inventor.Face) As Boolean
    If Face Is Nothing Then Return False

    Try
        If Face.SurfaceType = Inventor.SurfaceTypeEnum.kPlaneSurface Then
            Return True
        End If
    Catch
        ' Try geometry type below.
    End Try

    Try
        If TypeOf Face.Geometry Is Inventor.Plane Then
            Return True
        End If
    Catch
        ' Geometry type is not exposed as a Plane.
    End Try

    Return False
End Function


Function TryGetFaceArea(Face As Inventor.Face) As Double
    If Face Is Nothing Then Return 0

    Try
        ' Face.Evaluator.Area is the Inventor SurfaceEvaluator area property.
        ' Inventor database area units are cm^2. Face.Area is not used here,
        ' because the evaluator is the documented geometry measurement route.
        Dim FaceEvaluator As Inventor.SurfaceEvaluator = Face.Evaluator
        Return FaceEvaluator.Area
    Catch ex As Exception
        Logger.Debug("Unable to retrieve planar face area from SurfaceEvaluator: " & ex.Message)
        Return 0
    End Try
End Function


' ------------------------------------------------------------
' EDGE GEOMETRY HELPERS
' ------------------------------------------------------------

Function IsStraightEdge(Edge As Inventor.Edge) As Boolean
    If Edge Is Nothing Then Return False

    Try
        Return TypeOf Edge.Geometry Is Inventor.LineSegment
    Catch
        Return False
    End Try
End Function


Function GetStraightEdgeLengthMM( _
    PartDoc As Inventor.PartDocument, _
    Edge As Inventor.Edge) As Double

    If PartDoc Is Nothing OrElse Edge Is Nothing Then Return 0

    Try
        If Not IsStraightEdge(Edge) Then Return 0
        If Edge.StartVertex Is Nothing OrElse Edge.StopVertex Is Nothing Then Return 0

        ' Inventor database length units are centimetres; convert to mm.
        Dim LengthCM As Double = Edge.StartVertex.Point.DistanceTo(Edge.StopVertex.Point)
        Return PartDoc.UnitsOfMeasure.ConvertUnits(LengthCM, "cm", "mm")
    Catch
        Return 0
    End Try
End Function


' ============================================================
' SHEET METAL CHECK
' ============================================================

Function IsSheetMetalPart( _
    PartDoc As Inventor.PartDocument) As Boolean


    Try


        Dim Definition As Inventor.ComponentDefinition = _
            PartDoc.ComponentDefinition


        If TypeOf Definition Is _
            Inventor.SheetMetalComponentDefinition Then

            Return True

        End If


    Catch ex As Exception

        Logger.Debug( _
            "Sheet metal check failed: " & _
            ex.Message)

    End Try


    Return False


End Function



' ============================================================
' GET PHYSICAL PLATE THICKNESS
'
' IMPORTANT:
'
' This function measures the physical geometry.
'
' It does NOT use the sheet-metal thickness parameter as the
' thickness returned to the automation.
'
' The sheet-metal parameter is read only so that we can detect
' and report discrepancies.
'
' Inventor's OrientedMinimumRangeBox provides the minimum
' oriented dimensions of the component geometry.
'
' ============================================================

Function GetPhysicalPlateThicknessMM( _
    PartDoc As Inventor.PartDocument, _
    ByRef ParameterThicknessMM As Double) As Double


    ParameterThicknessMM = 0


    Try


        ' ----------------------------------------------------
        ' GET SHEET METAL DEFINITION
        ' ----------------------------------------------------

        Dim SheetMetalDef As _
            Inventor.SheetMetalComponentDefinition = _
            CType( _
                PartDoc.ComponentDefinition, _
                Inventor.SheetMetalComponentDefinition)


        ' ----------------------------------------------------
        ' READ PARAMETER ONLY FOR COMPARISON
        ' ----------------------------------------------------

        Try

            ParameterThicknessMM = _
                PartDoc.UnitsOfMeasure.ConvertUnits( _
                    SheetMetalDef.Thickness.Value, _
                    "cm", _
                    "mm")

        Catch

            ParameterThicknessMM = 0

        End Try


        ' ----------------------------------------------------
        ' GET PHYSICAL GEOMETRY
        ' ----------------------------------------------------

        Dim PartDef As Inventor.PartComponentDefinition = _
            CType( _
                PartDoc.ComponentDefinition, _
                Inventor.PartComponentDefinition)


        Dim MinimumBox As Inventor.OrientedBox = _
            PartDef.OrientedMinimumRangeBox


        ' ----------------------------------------------------
        ' GET THE THREE PHYSICAL DIMENSIONS
        '
        ' Direction lengths are returned in Inventor's
        ' database units (cm).
        ' ----------------------------------------------------

        Dim DimensionOneMM As Double = _
            PartDoc.UnitsOfMeasure.ConvertUnits( _
                MinimumBox.DirectionOne.Length, _
                "cm", _
                "mm")


        Dim DimensionTwoMM As Double = _
            PartDoc.UnitsOfMeasure.ConvertUnits( _
                MinimumBox.DirectionTwo.Length, _
                "cm", _
                "mm")


        Dim DimensionThreeMM As Double = _
            PartDoc.UnitsOfMeasure.ConvertUnits( _
                MinimumBox.DirectionThree.Length, _
                "cm", _
                "mm")


        ' ----------------------------------------------------
        ' SMALLEST PHYSICAL DIMENSION
        '
        ' For a flat plate this is the material thickness.
        ' ----------------------------------------------------

        Dim PhysicalThicknessMM As Double = _
            Math.Min( _
                DimensionOneMM, _
                Math.Min( _
                    DimensionTwoMM, _
                    DimensionThreeMM))


        If PhysicalThicknessMM <= 0 Then

            Return 0

        End If


        Return PhysicalThicknessMM


    Catch ex As Exception


        Logger.Debug( _
            "Physical thickness measurement failed: " & _
            ex.Message)


        Return 0


    End Try


End Function



' ============================================================
' PART NAME DATA
' ============================================================

Class PartNameData

    Public IsValid As Boolean = False

    Public ProjectNumber As String

    Public ProjectIdentifier As String

    Public ComponentType As String

    Public ComponentNumber As String

    Public Revision As String

End Class



' ============================================================
' PARSE PART NAME
'
' Format:
'
' XXXX-CCC-VVBB-NN
'
' Example:
'
' 9187-DCS-PL07-03
'
' ============================================================

Function ParsePartName( _
    Name As String) As PartNameData


    Dim Result As New PartNameData


    Dim Pattern As String = _
        "^([0-9]{4})-([A-Za-z]{3})-([A-Za-z]{2})([0-9]{2})-([0-9]{2})$"


    Dim Match As _
        System.Text.RegularExpressions.Match = _
        System.Text.RegularExpressions.Regex.Match( _
            Name, _
            Pattern)


    If Not Match.Success Then

        Return Result

    End If


    Result.IsValid = True


    Result.ProjectNumber = _
        Match.Groups(1).Value


    Result.ProjectIdentifier = _
        Match.Groups(2).Value


    Result.ComponentType = _
        Match.Groups(3).Value.ToUpper()


    Result.ComponentNumber = _
        Match.Groups(4).Value


    Result.Revision = _
        Match.Groups(5).Value


    Return Result


End Function



' ============================================================
' ASSEMBLY NAME DATA
' ============================================================

Class AssemblyNameData

    Public IsValid As Boolean = False

    Public ProjectNumber As String

    Public Description As String

    Public AssemblyType As String

    Public AssemblyNumber As String

    Public Revision As String

End Class



' ============================================================
' PARSE ASSEMBLY NAME
'
' Format:
'
' XXXX-DESCRIPTION-TTNN-VV
'
' Examples:
'
' 9187-DitchCrossingSlab-GA01-01
' 9187-InternalStructure-SA01-01
'
' ============================================================

Function ParseAssemblyName( _
    Name As String) As AssemblyNameData


    Dim Result As New AssemblyNameData


    Dim Pattern As String = _
        "^([0-9]{4})-(.+)-([A-Za-z]{2})([0-9]{2})-([0-9]{2})$"


    Dim Match As _
        System.Text.RegularExpressions.Match = _
        System.Text.RegularExpressions.Regex.Match( _
            Name, _
            Pattern)


    If Not Match.Success Then

        Return Result

    End If


    Result.IsValid = True


    Result.ProjectNumber = _
        Match.Groups(1).Value


    Result.Description = _
        Match.Groups(2).Value


    Result.AssemblyType = _
        Match.Groups(3).Value.ToUpper()


    Result.AssemblyNumber = _
        Match.Groups(4).Value


    Result.Revision = _
        Match.Groups(5).Value


    Return Result


End Function



' ============================================================
' DISPLAY LOG
'
' Scrollable log window.
'
' ============================================================

Sub ShowLog()


    Dim LogText As String = _
        Logger.GetText()


    Dim LogForm As New System.Windows.Forms.Form


    LogForm.Text = _
        "Inventor Nib Automation Log"


    LogForm.StartPosition = _
        System.Windows.Forms.FormStartPosition.CenterScreen


    LogForm.Width = 1000

    LogForm.Height = 700


    LogForm.MaximizeBox = True

    LogForm.MinimizeBox = True


    ' --------------------------------------------------------
    ' LOG TEXT BOX
    ' --------------------------------------------------------

    Dim LogBox As New System.Windows.Forms.TextBox


    LogBox.Multiline = True

    LogBox.ReadOnly = True


    LogBox.ScrollBars = _
        System.Windows.Forms.ScrollBars.Both


    LogBox.WordWrap = False


    LogBox.Dock = _
        System.Windows.Forms.DockStyle.Fill


    LogBox.Text = LogText


    ' --------------------------------------------------------
    ' CLOSE BUTTON
    ' --------------------------------------------------------

    Dim CloseButton As _
        New System.Windows.Forms.Button


    CloseButton.Text = "Close"


    CloseButton.Width = 100

    CloseButton.Height = 30


    CloseButton.Dock = _
        System.Windows.Forms.DockStyle.Bottom


    CloseButton.DialogResult = _
        System.Windows.Forms.DialogResult.OK


    ' --------------------------------------------------------
    ' ADD CONTROLS
    ' --------------------------------------------------------

    LogForm.Controls.Add(LogBox)

    LogForm.Controls.Add(CloseButton)


    ' --------------------------------------------------------
    ' BUTTON BEHAVIOUR
    ' --------------------------------------------------------

    LogForm.AcceptButton = CloseButton

    LogForm.CancelButton = CloseButton


    ' --------------------------------------------------------
    ' DISPLAY
    ' --------------------------------------------------------

    LogForm.ShowDialog()


End Sub



' ============================================================
' LOGGER
'
' Central logging system for the entire automation.
'
' ============================================================

Class Logger


    Private Shared LogLines As _
        New System.Collections.Generic.List(Of String)


    ' --------------------------------------------------------
    ' START
    ' --------------------------------------------------------

    Public Shared Sub Start()


        LogLines.Clear()


        WriteLine( _
            "============================================================")


        WriteLine( _
            "INVENTOR NIB AUTOMATION LOG")


        WriteLine( _
            "Started: " & _
            DateTime.Now.ToString( _
                "yyyy-MM-dd HH:mm:ss"))


        WriteLine( _
            "============================================================")


    End Sub


    ' --------------------------------------------------------
    ' INFO
    ' --------------------------------------------------------

    Public Shared Sub Info( _
        Message As String)


        WriteLine( _
            "[INFO]    " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' SUCCESS
    ' --------------------------------------------------------

    Public Shared Sub Success( _
        Message As String)


        WriteLine( _
            "[SUCCESS] " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' WARNING
    ' --------------------------------------------------------

    Public Shared Sub Warning( _
        Message As String)


        WriteLine( _
            "[WARNING] " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' ERROR
    ' --------------------------------------------------------

    Public Shared Sub [Error]( _
        Message As String)


        WriteLine( _
            "[ERROR]   " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' DEBUG
    ' --------------------------------------------------------

    Public Shared Sub Debug( _
        Message As String)


        WriteLine( _
            "[DEBUG]   " & _
            Message)


    End Sub


    ' --------------------------------------------------------
    ' SECTION
    ' --------------------------------------------------------

    Public Shared Sub Section( _
        Name As String)


        WriteLine("")


        WriteLine( _
            "------------------------------------------------------------")


        WriteLine( _
            Name)


        WriteLine( _
            "------------------------------------------------------------")


    End Sub


    ' --------------------------------------------------------
    ' INTERNAL WRITE METHOD
    ' --------------------------------------------------------

    Private Shared Sub WriteLine( _
        Message As String)


        Dim TimeStamp As String = _
            DateTime.Now.ToString("HH:mm:ss")


        ' --------------------------------------------------------
        ' ALIGN LOG MESSAGE CONTENT
        '
        ' Keep the severity labels in a fixed-width column so that
        ' the actual log message always starts at the same position.
        '
        ' Three spaces are added after the longest severity label
        ' ([SUCCESS] / [WARNING]) to give the log a little more
        ' separation between the identifier and the message.
        ' --------------------------------------------------------

        Dim FormattedMessage As String = Message


		If Message.StartsWith("[INFO]") Then
		
		    FormattedMessage = _
		        "[INFO]" & _
		        Message.Substring(6).TrimStart().PadLeft( _
		            Message.Substring(6).TrimStart().Length + 11)
		
		
		ElseIf Message.StartsWith("[SUCCESS]") Then
		
		    FormattedMessage = _
		        "[SUCCESS]" & _
		        Message.Substring(9).TrimStart().PadLeft( _
		            Message.Substring(9).TrimStart().Length + 5)
		
		
		ElseIf Message.StartsWith("[WARNING]") Then
		
		    FormattedMessage = _
		        "[WARNING]" & _
		        Message.Substring(9).TrimStart().PadLeft( _
		            Message.Substring(9).TrimStart().Length + 3)
		
		
		ElseIf Message.StartsWith("[ERROR]") Then
		
		    FormattedMessage = _
		        "[ERROR]" & _
		        Message.Substring(7).TrimStart().PadLeft( _
		            Message.Substring(7).TrimStart().Length + 10)
		
		
		ElseIf Message.StartsWith("[DEBUG]") Then
		
		    FormattedMessage = _
		        "[DEBUG]" & _
		        Message.Substring(7).TrimStart().PadLeft( _
		            Message.Substring(7).TrimStart().Length + 8)
		
		End If


        LogLines.Add( _
            "[" & _
            TimeStamp & _
            "] " & _
            FormattedMessage)


    End Sub


    ' --------------------------------------------------------
    ' RETURN COMPLETE LOG
    ' --------------------------------------------------------

    Public Shared Function GetText() As String


        Return String.Join( _
            vbCrLf, _
            LogLines)


    End Function


    ' --------------------------------------------------------
    ' SAVE LOG TO FILE
    ' --------------------------------------------------------

    Public Shared Sub SaveToFile( _
        FilePath As String)


        Try


            System.IO.File.WriteAllText( _
                FilePath, _
                GetText())


        Catch ex As Exception


            MsgBox( _
                "Unable to save log file:" & _
                vbCrLf & _
                ex.Message)


        End Try


    End Sub


End Class

